<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Instant («always»): every value listed on a product is a variant of
             its own the moment it is listed, so the storekeepers see one line
             per characteristic in every list. Only the values a product really
             comes in are ever listed, so a board with 2 finishes, 1 density and
             1 size has 2 variants, not 324. (These records are noupdate: the
             mode in the database is kept in step by the migrations.) -->
        <record id="attribute_surface" model="product.attribute">
            <field name="name">Ustki qismi</field>
            <field name="sequence">10</field>
            <field name="create_variant">always</field>
            <field name="display_type">select</field>
        </record>
        <record id="attribute_density" model="product.attribute">
            <field name="name">Zichligi</field>
            <field name="sequence">20</field>
            <field name="create_variant">always</field>
            <field name="display_type">pills</field>
        </record>
        <record id="attribute_size" model="product.attribute">
            <field name="name">Uzunligi va eni</field>
            <field name="sequence">30</field>
            <field name="create_variant">always</field>
            <field name="display_type">pills</field>
        </record>

        <record id="value_surface_3d" model="product.attribute.value">
            <field name="name">3D</field>
            <field name="attribute_id" ref="attribute_surface"/>
            <field name="sequence">10</field>
        </record>
        <record id="value_surface_archa" model="product.attribute.value">
