<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_variant_assign_wizard_form" model="ir.ui.view">
        <field name="name">cst.variant.assign.wizard.form</field>
        <field name="model">cst.variant.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Xarakteristika biriktirish">
                <group invisible="summary">
                    <field name="product_tmpl_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <group invisible="summary" string="Hozirgi mahsulot qanday? (bitta qiymat)">
                    <p class="text-muted" colspan="2">Ombordagi mavjud mahsulot shu qiymatlarni oladi — kodi, qoldig'i va tarixi saqlanib qoladi. Tegishli bo'lmagan xarakteristikani bo'sh qoldiring.</p>
                    <field name="surface_id" options="{'no_create': True}"/>
                    <field name="density_id" options="{'no_create': True}"/>
                    <field name="size_id" options="{'no_create': True}"/>
                </group>
                <group invisible="summary" string="Yana qanday variantlarda bo'ladi?">
                    <field name="surface_extra_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="density_extra_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="size_extra_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <group invisible="not summary" string="Natija">
                    <field name="summary" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Biriktirish" class="btn-primary" invisible="summary"/>
                    <button string="Yopish" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- reachable from the product list's Action menu -->
    <record id="action_variant_assign_wizard" model="ir.actions.act_window">
        <field name="name">Xarakteristika biriktirish</field>
        <field name="res_model">cst.variant.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>
    <record id="action_variant_assign_wizard_variant" model="ir.actions.act_window">
        <field name="name">Xarakteristika biriktirish</field>
        <field name="res_model">cst.variant.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <menuitem id="menu_variant_assign" name="Xarakteristika biriktirish"
              parent="stock.menu_stock_inventory_control" action="action_variant_assign_wizard"
              groups="product.group_product_manager,stock.group_stock_manager" sequence="95"/>

</odoo>
