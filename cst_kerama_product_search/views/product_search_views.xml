<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The search box of the product lists queries `name ilike` directly,
         bypassing _search_display_name.  Pointing the field at display_name
         sends it through the word-by-word search (name, code, barcode,
         characteristic) like the many2one dropdowns. -->

    <record id="product_template_search_view_words" model="ir.ui.view">
        <field name="name">product.template.search.words</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">[('display_name', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_search_form_view_words" model="ir.ui.view">
        <field name="name">product.product.search.words</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">[('display_name', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- the «Katalog» picker opened from an order line -->
    <record id="product_view_search_catalog_words" model="ir.ui.view">
        <field name="name">product.product.search.catalog.words</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_view_search_catalog"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">[('display_name', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
