<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_telegram_broadcast_list" model="ir.ui.view">
        <field name="name">cst.telegram.broadcast.list</field>
        <field name="model">cst.telegram.broadcast</field>
        <field name="arch" type="xml">
            <list string="Xabarlar">
                <field name="name"/>
                <field name="audience"/>
                <field name="recipient_count"/>
                <field name="sent_count"/>
                <field name="failed_count" optional="show"/>
                <field name="sent_date" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_broadcast_form" model="ir.ui.view">
        <field name="name">cst.telegram.broadcast.form</field>
        <field name="model">cst.telegram.broadcast</field>
        <field name="arch" type="xml">
            <form string="Xabar">
                <header>
                    <button name="action_send" type="object" string="Yuborish"
                            class="btn-primary" invisible="state == 'sent'"
                            confirm="Хабар ботда узини танитган контрагентларга юборилади.  Давом этамизми?"/>
                    <button name="action_reset" type="object" string="Qoralamaga qaytarish"
                            invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Masalan: Yangi narxlar"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="audience"/>
                            <field name="partner_ids" widget="many2many_tags"
                                   invisible="audience != 'selected'"
                                   required="audience == 'selected'"/>
                        </group>
                        <group>
                            <field name="recipient_count"/>
                            <field name="sent_count" invisible="state != 'sent'"/>
                            <field name="failed_count" invisible="state != 'sent'"/>
                            <field name="sent_date" invisible="state != 'sent'"/>
                        </group>
                    </group>
                    <field name="body" placeholder="Xabar matni..." nolabel="1"
                           readonly="state == 'sent'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_telegram_broadcast" model="ir.actions.act_window">
        <field name="name">Telegram xabarlari</field>
        <field name="res_model">cst.telegram.broadcast</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hali xabar yuborilmagan</p>
            <p>Ботда узини танитган мижозларга ёки етказиб берувчиларга
               хабар юборинг.</p>
        </field>
    </record>

</odoo>
