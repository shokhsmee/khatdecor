<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_full_payment_button" model="ir.ui.view">
        <field name="name">sale.order.form.full.payment.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_confirm" id="action_confirm" position="after">
                <field name="cst_can_full_pay" invisible="1"/>
                <button name="action_open_full_payment_wizard"
                        string="To'liq to'lov"
                        type="object"
                        class="btn-primary"
                        invisible="not cst_can_full_pay"/>
            </button>
        </field>
    </record>

</odoo>
