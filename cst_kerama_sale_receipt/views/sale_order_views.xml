<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_sale_receipt" model="ir.ui.view">
        <field name="name">sale.order.form.sale.receipt</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_sale_receipt"
                        type="object"
                        string="Chek chiqarish"
                        class="btn-secondary"
                        icon="fa-print"
                        invisible="state != 'sale'"/>
            </xpath>
        </field>
    </record>

</odoo>
