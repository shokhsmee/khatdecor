<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_cst_ux" model="ir.ui.view">
        <field name="name">purchase.order.form.cst.ux</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">

            <!-- the warehouse sits under the supplier, where the vendor
                 reference used to be; the reference itself is not used -->
            <xpath expr="//field[@name='partner_ref']" position="after">
                <xpath expr="//field[@name='picking_type_id']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- the expected arrival gives way to the vehicle's plate -->
            <xpath expr="//label[@for='date_planned']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='date_planned_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='date_planned_div']" position="after">
                <field name="cst_car_number" placeholder="40 A 123 BC"/>
            </xpath>

            <!-- line total typed in, unit price worked out; quantities summed at the foot -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="attributes">
                <attribute name="sum">Jami miqdor</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='qty_received']" position="attributes">
                <attribute name="sum">Jami qabul</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='qty_invoiced']" position="attributes">
                <attribute name="sum">Jami hisobda</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <field name="cst_line_total" readonly="qty_invoiced != 0 or display_type" sum="Jami summa"/>
            </xpath>
            <xpath expr="//page[@name='products']" position="after">
                <page string="Rasmlar" name="cst_photos">
                    <div class="text-muted mb-2">
                        <i class="fa fa-camera me-1"/>
                        Buyurtma ochilishi bilan rasm yuklash mumkin — narxlar
                        kiritilishini kutmasdan.
                    </div>
                    <field name="cst_photo_ids" widget="many2many_binary"
                           readonly="state == 'cancel'"/>
                    <separator string="Qabul (kirim) hujjatidagi rasmlar"
                               invisible="not cst_receipt_photo_ids"/>
                    <field name="cst_receipt_photo_ids" widget="many2many_binary"
                           readonly="1" invisible="not cst_receipt_photo_ids"/>
                </page>
                <page string="Xarajatlar" name="cst_expenses">
                    <div class="text-muted mb-2" invisible="cst_receipt_expense_ids">
                        <i class="fa fa-info-circle me-1"/>
                        Xarajatlar (transport, bojxona, yuk tushirish…) qabul
                        hujjatining «Xarajatlar» sahifasida kiritiladi va shu
                        yerda ko'rinadi.
                    </div>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="cst_receipt_expense_ids" readonly="1" nolabel="1"
                           invisible="not cst_receipt_expense_ids">
                        <list>
                            <field name="date"/>
                            <field name="picking_id" string="Qabul"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="name" optional="show"/>
                            <field name="quantity" optional="hide"/>
                            <field name="price_unit" optional="hide"/>
                            <field name="amount"/>
                            <field name="currency_id" optional="hide"/>
                            <field name="amount_company" sum="Jami"/>
                            <field name="company_currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group invisible="not cst_receipt_expense_ids">
                        <field name="cst_receipt_expense_total"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
