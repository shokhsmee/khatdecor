#. module: cst_kerama_project
#: model_terms:ir.ui.view,arch_db:cst_kerama_project.view_cst_manufacture_wizard_form
msgid ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                Products of the material request are loaded here. Add a line to\n"
"                                manufacture something the request does not cover, then press\n"
"                                <b>Load operations &amp; materials</b> to fill the other tabs\n"
"                                from its bill of materials."
msgstr ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                Material so'rovidagi mahsulotlar shu yerga yuklanadi. So'rovda\n"
"                                yo'q mahsulotni ishlab chiqarish uchun qator qo'shing va\n"
"                                <b>Operatsiya va materiallarni yuklash</b> tugmasini bosing -\n"
"                                qolgan bo'limlar uning materiallar ro'yxatidan to'ladi."

#. module: cst_kerama_project
#: model_terms:ir.ui.view,arch_db:cst_kerama_project.view_cst_manufacture_wizard_form
msgid ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                Set <b>Used By</b> to the operation that consumes a material and\n"
"                                it is only taken when that operation is part of the order. Leave\n"
"                                it empty for a material the order always needs. The bill of\n"
"                                materials itself is never changed."
msgstr ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                Materialni sarflaydigan operatsiyani <b>Qaysi operatsiyada</b>\n"
"                                ustunida belgilang - u faqat o'sha operatsiya buyurtmaga kirganda\n"
"                                sarflanadi. Buyurtmaga doim kerak bo'ladigan material uchun bo'sh\n"
"                                qoldiring. Materiallar ro'yxatining o'ziga hech qachon tegilmaydi."

#. module: cst_kerama_project
#: model_terms:ir.ui.view,arch_db:cst_kerama_project.view_cst_manufacture_wizard_form
msgid ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                Untick the operations this order does not run — only ticked ones\n"
"                                become work orders. Split an operation over several work centers\n"
"                                by adding a line for the same operation: the quantities of one\n"
"                                operation must add up to the quantity of its product."
msgstr ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                Ushbu buyurtmada bajarilmaydigan operatsiyalarni belgidan chiqaring -\n"
"                                faqat belgilanganlari ish buyurtmasiga aylanadi. Operatsiyani bir\n"
"                                nechta sexga bo'lish uchun o'sha operatsiya bilan yana qator qo'shing:\n"
"                                bitta operatsiya miqdorlari mahsulot miqdoriga teng bo'lishi shart."

#. module: cst_kerama_project
#: model_terms:ir.ui.view,arch_db:cst_kerama_project.cst_material_request_view_form
msgid ""
"<i class=\"fa fa-info-circle\"/>\n"
"                                <span>\n"
"                                    Add every product this project needs. Set <b>Supply</b> to\n"
"                                    <b>Buy</b> to order it from a vendor, or <b>Manufacture</b>\n"
"                                    to produce it from its bill of materials. <b>In Stock</b>,\n"
"                                    <b>To Buy</b> and <b>To Produce</b> are filled in from the\n"
"                                    warehouse and can be adjusted.\n"
"                                </span>"
msgstr ""
"<i class=\"fa fa-info-circle\"/>\n"
"                                <span>\n"
"                                    Loyihaga kerak bo'lgan har bir mahsulotni qo'shing. <b>Ta'minot</b> ustunida\n"
"                                    <b>Sotib olish</b> ni tanlasangiz yetkazib beruvchidan buyurtma qilinadi, <b>Ishlab chiqarish</b>\n"
"                                    ni tanlasangiz materiallar ro'yxati asosida o'zimizda ishlab chiqariladi. <b>Omborda</b>,\n"
"                                    <b>Sotib olish</b> va <b>Ishlab chiqarish</b> ustunlari ombor bo'yicha\n"
"                                    to'ldiriladi va o'zgartirilishi mumkin.\n"
"                                </span>"

