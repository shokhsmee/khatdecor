<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cst_picking_correction_form" model="ir.ui.view">
        <field name="name">cst.picking.correction.form</field>
        <field name="model">cst.picking.correction</field>
        <field name="arch" type="xml">
            <form string="Ichki ko'chirishni tuzatish">
                <field name="picking_id" invisible="1"/>
                <div class="alert alert-info small" role="status">
                    Bajarilgan hujjat o'zgartirilmaydi: farq alohida hujjat bilan yoziladi — ko'p ko'chirilgan bo'lsa
                    ortig'i qaytariladi, kam bo'lsa qolgani qo'shimcha ko'chiriladi. Ikkalasi ham darhol tasdiqlanadi.
                </div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="move_id" column_invisible="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="old_qty"/>
                        <field name="new_qty"/>
                        <field name="uom_id" readonly="1"/>
                    </list>
                </field>
                <field name="reason" placeholder="Nega tuzatilmoqda? (majburiy)" required="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Tuzatish" class="btn-primary"
                            confirm="Farq uchun ko'chirish yaratiladi va tasdiqlanadi. Davom etilsinmi?"/>
                    <button special="cancel" string="Bekor" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_picking_form_cst_correction" model="ir.ui.view">
        <field name="name">stock.picking.form.cst.correction</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="cst_can_correct" invisible="1"/>
                <button name="action_cst_open_correction" type="object" string="Tuzatish" class="btn-warning"
                        invisible="not cst_can_correct" groups="cst_kerama_shift.group_doc_correction"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Tuzatishlar" name="cst_corrections" invisible="not cst_correction_ids and not cst_correction_of_id">
                    <group>
                        <field name="cst_correction_of_id" invisible="not cst_correction_of_id"/>
                        <field name="cst_correction_log" invisible="not cst_correction_log"/>
                    </group>
                    <field name="cst_correction_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="date_done"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
