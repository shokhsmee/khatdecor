<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_dispatch" model="res.groups.privilege">
        <field name="name">Jo'natish</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="description">Dispatch app: warehouse preparation and gate check.</field>
        <field name="sequence">32</field>
    </record>

    <record id="group_dispatch_warehouse" model="res.groups">
        <field name="name">Jo'natish: ombor menejeri</field>
        <field name="privilege_id" ref="privilege_dispatch"/>
        <field name="comment">Prepares sales orders for dispatch: quantities, extra products.</field>
    </record>

    <record id="group_dispatch_gate" model="res.groups">
        <field name="name">Jo'natish: eshik qorovuli</field>
        <field name="privilege_id" ref="privilege_dispatch"/>
        <field name="comment">Checks ready orders at the gate and approves them.</field>
    </record>

    <record id="group_dispatch_transfer" model="res.groups">
        <field name="name">Jo'natish: ichki o'tkazmalar</field>
        <field name="privilege_id" ref="privilege_dispatch"/>
        <field name="comment">Sends goods between warehouses and receives the ones addressed to them.</field>
    </record>

    <record id="group_dispatch_manager" model="res.groups">
        <field name="name">Jo'natish: ombor va eshik</field>
        <field name="privilege_id" ref="privilege_dispatch"/>
        <field name="implied_ids" eval="[Command.link(ref('group_dispatch_warehouse')), Command.link(ref('group_dispatch_gate')), Command.link(ref('group_dispatch_transfer'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_dispatch_manager'))]"/>
    </record>

    <record id="rule_dispatch_company" model="ir.rule">
        <field name="name">Jo'natish: kompaniya</field>
        <field name="model_id" ref="model_cst_dispatch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dispatch_line_company" model="ir.rule">
        <field name="name">Jo'natish qatori: kompaniya</field>
        <field name="model_id" ref="model_cst_dispatch_line"/>
        <field name="domain_force">[('dispatch_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
