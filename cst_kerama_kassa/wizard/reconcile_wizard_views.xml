<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kassa_reconcile_wizard_form" model="ir.ui.view">
        <field name="name">cst.kassa.reconcile.wizard.form</field>
        <field name="model">cst.kassa.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form class="o_cst_kassa_reconcile">
                <group>
                    <group>
                        <field name="partner_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <div class="cst_kassa_totals">
                    <div class="cst_kassa_tile cst_kassa_in"><span>Free money</span><field name="available"/></div>
                    <div class="cst_kassa_tile cst_kassa_out"><span>Selected debts</span><field name="selected_debt"/></div>
                    <div class="cst_kassa_tile cst_kassa_expected"><span>Will be settled</span><field name="to_settle"/></div>
                    <div class="cst_kassa_tile"><span>Stays as advance</span><field name="advance_left"/></div>
                    <div class="cst_kassa_tile"><span>Debt left</span><field name="debt_left"/></div>
                </div>
                <separator string="1. Client money that is not settled yet"/>
                <field name="credit_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="use" widget="boolean_toggle"/>
                        <field name="line_id" column_invisible="1" force_save="1"/>
                        <field name="date" readonly="1" force_save="1"/>
                        <field name="name" readonly="1" force_save="1"/>
                        <field name="memo" readonly="1" force_save="1"/>
                        <field name="orig_currency_id" column_invisible="1" force_save="1"/>
                        <field name="orig_amount" readonly="1" force_save="1" optional="show"
                               invisible="not orig_currency_id"/>
                        <field name="rate" readonly="1" force_save="1" optional="show" invisible="not rate"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="amount" readonly="1" force_save="1" sum="1"/>
                    </list>
                </field>
                <separator string="2. Debts — paid from the top (oldest first)"/>
                <field name="debt_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="sequence" column_invisible="1" force_save="1"/>
                        <field name="order_id" column_invisible="1" force_save="1"/>
                        <field name="invoice_id" column_invisible="1" force_save="1"/>
                        <field name="date" readonly="1" force_save="1"/>
                        <field name="name" readonly="1" force_save="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="total" readonly="1" force_save="1" sum="1"/>
                        <field name="debt" readonly="1" force_save="1" sum="1"/>
                        <field name="preview" sum="1" decoration-success="preview &gt; 0" decoration-bf="preview &gt; 0"/>
                        <field name="debt_after" sum="1" decoration-danger="debt_after &gt; 0"/>
                    </list>
                </field>
                <footer>
                    <button name="action_reconcile" type="object" string="Settle" class="btn-primary"
                            invisible="to_settle &lt;= 0"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kassa_reconcile_wizard" model="ir.actions.act_window">
        <field name="name">Settle client account</field>
        <field name="res_model">cst.kassa.reconcile.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
