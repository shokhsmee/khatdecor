<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_kassa" model="ir.module.category">
        <field name="name">Kassa</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_kassa" model="res.groups.privilege">
        <field name="name">Kassa</field>
        <field name="category_id" ref="module_category_kassa"/>
    </record>

    <record id="group_kassa_user" model="res.groups">
        <field name="name">Cashier</field>
        <field name="privilege_id" ref="privilege_kassa"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Opens and closes the cash day, receives and pays money.</field>
    </record>

    <record id="group_kassa_manager" model="res.groups">
        <field name="name">Kassa manager</field>
        <field name="privilege_id" ref="privilege_kassa"/>
        <field name="implied_ids" eval="[Command.link(ref('group_kassa_user'))]"/>
        <field name="comment">Confirms and reopens cash days, manages cash desks and categories.</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- multi-company -->
    <record id="rule_kassa_company" model="ir.rule">
        <field name="name">Kassa: multi-company</field>
        <field name="model_id" ref="model_cst_kassa"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kassa_day_company" model="ir.rule">
        <field name="name">Cash day: multi-company</field>
        <field name="model_id" ref="model_cst_kassa_day"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kassa_operation_company" model="ir.rule">
        <field name="name">Cash operation: multi-company</field>
        <field name="model_id" ref="model_cst_kassa_operation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kassa_category_company" model="ir.rule">
        <field name="name">Cash category: multi-company</field>
        <field name="model_id" ref="model_cst_kassa_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kassa_allocation_company" model="ir.rule">
        <field name="name">Settlement: multi-company</field>
        <field name="model_id" ref="model_cst_kassa_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kassa_balance_company" model="ir.rule">
        <field name="name">Client account: multi-company</field>
        <field name="model_id" ref="model_cst_kassa_partner_balance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- a cashier sees only his own cash desks (or desks with no cashier list) -->
    <record id="rule_kassa_own" model="ir.rule">
        <field name="name">Kassa: own cash desks</field>
        <field name="model_id" ref="model_cst_kassa"/>
        <field name="domain_force">['|', ('user_ids', '=', False), ('user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_kassa_user'))]"/>
    </record>
    <record id="rule_kassa_own_manager" model="ir.rule">
        <field name="name">Kassa: manager sees all</field>
        <field name="model_id" ref="model_cst_kassa"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_kassa_manager'))]"/>
    </record>
    <record id="rule_kassa_day_own" model="ir.rule">
        <field name="name">Cash day: own cash desks</field>
        <field name="model_id" ref="model_cst_kassa_day"/>
        <field name="domain_force">['|', ('kassa_id.user_ids', '=', False), ('kassa_id.user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_kassa_user'))]"/>
    </record>
    <record id="rule_kassa_day_own_manager" model="ir.rule">
        <field name="name">Cash day: manager sees all</field>
        <field name="model_id" ref="model_cst_kassa_day"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_kassa_manager'))]"/>
    </record>
    <record id="rule_kassa_operation_own" model="ir.rule">
        <field name="name">Cash operation: own cash desks</field>
        <field name="model_id" ref="model_cst_kassa_operation"/>
        <field name="domain_force">['|', ('kassa_id.user_ids', '=', False), ('kassa_id.user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_kassa_user'))]"/>
    </record>
    <record id="rule_kassa_operation_own_manager" model="ir.rule">
        <field name="name">Cash operation: manager sees all</field>
        <field name="model_id" ref="model_cst_kassa_operation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_kassa_manager'))]"/>
    </record>
</odoo>
