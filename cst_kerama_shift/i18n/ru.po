#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
msgid ""
"ta buyurtma hali jarayonda: chiqarilgani omborga o'tadi, qolgani keyingi "
"smenaga ochiq qoladi."
msgstr ""
"заказ(ов) ещё в работе: выпущенное идёт на склад, остальное остаётся "
"открытым на следующую смену."

#. module: cst_kerama_shift
#: model_terms:ir.ui.view,arch_db:cst_kerama_shift.view_shift_close_form
msgid ""
"ta buyurtma hali jarayonda: yopilganda chiqarilgani omborga o'tadi, qolgani "
"keyingi smenaga ochiq qoladi."
msgstr ""
"заказ(ов) ещё в работе: при закрытии выпущенное идёт на склад, остальное "
"остаётся открытым на следующую смену."

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/mo_builder/mo_dialog.xml:0
msgid "ta mahsulot"
msgstr "товар(ов)"

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/mo_builder/mo_dialog.xml:0
msgid ""
"ta material. Buyurtma baribir yaratiladi,\n"
"                                xomashyo kelgach zaxira qilinadi."
msgstr ""
"материал(ов). Заказ всё равно будет создан,\n"
"                                сырьё зарезервируется после поступления."

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
msgid "ta o'zgartirilgan"
msgstr "изменено"

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
msgid "texkarta bo'yicha — o'zgartirish uchun oching"
msgstr "по техкарте — откройте, чтобы изменить"

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
#: code:addons/cst_kerama_shift/static/src/mo_builder/mo_dialog.xml:0
msgid "texkarta:"
msgstr "техкарта:"

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
msgid "uchun hali natija kiritilmagan."
msgstr "— результат ещё не введён."

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
#: model_terms:ir.ui.view,arch_db:cst_kerama_shift.view_department_kanban
msgid "xodim"
msgstr "сотр."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift_line.py:0
msgid "«%s» allaqachon jarayonda yoki tugatilgan."
msgstr "«%s» уже в работе или завершён."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift.py:0
msgid "«%s» bo'limida allaqachon ochiq smena bor. Avval uni yoping."
msgstr "В цехе «%s» уже есть открытая смена. Сначала закройте её."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift_entry.py:0
msgid "«%s» bu smenada yakunlangan. Yangi qator oching."
msgstr "«%s» завершён в этой смене. Откройте новую строку."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/department.py:0
msgid "«%s» kodli bo'lim allaqachon bor."
msgstr "Цех с кодом «%s» уже существует."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/floor.py:0
msgid ""
"«%s» texkartasida bu bo'lim bajaradigan operatsiya yo'q. Buyurtma yaratildi,"
" lekin u boshqa bo'limning navbatiga tushdi."
msgstr ""
"В техкарте «%s» нет операции, которую выполняет этот цех. Заказ создан, но "
"попал в очередь другого цеха."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/floor.py:0
#: code:addons/cst_kerama_shift/models/mo_builder.py:0
msgid "«%s» uchun texkarta (BoM) yo'q."
msgstr "Для «%s» нет техкарты (BoM)."

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
msgid "· smena kuni"
msgstr "· день смены"

#. module: cst_kerama_shift
#: model:ir.model.fields,help:cst_kerama_shift.field_mrp_workorder__cst_shift
msgid ""
"Кайси сменада бажарилди.  Ишбай хисоботи участка ва смена буйича "
"гурухланади."
msgstr ""
"В какой смене выполнено.  Отчёт по сдельной оплате группируется по участку и"
" смене."

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
msgid "— hammasi —"
msgstr "— все —"

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
#: code:addons/cst_kerama_shift/static/src/mo_builder/mo_dialog.xml:0
msgid "— o'zgartirilgan"
msgstr "— изменено"

#. module: cst_kerama_shift
#. odoo-javascript
#: code:addons/cst_kerama_shift/static/src/floor/floor.xml:0
msgid "— yo'q —"
msgstr "— нет —"
