msgstr "%(product)s: фактический расход %(qty)s %(uom)s (из окна участка)."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/floor.py:0
msgid "%(shift)s: %(good)s dona qilingan"
msgstr "%(shift)s: сделано %(good)s шт."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift.py:0
msgid ""
"%(shift)s: oylik qatorlari allaqachon tasdiqlangan (%(n)s ta). KPI yoki "
"jarimani o'zgartirish uchun avval oylikda ularni qoralamaga qaytaring."
msgstr ""
"%(shift)s: строки зарплаты уже подтверждены (%(n)s шт.). Чтобы изменить KPI "
"или штраф, сначала верните их в черновик в зарплате."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift_worker.py:0
msgid "%(who)s: KPI %(kpi)s, jarima %(penalty)s (%(user)s)."
msgstr "%(who)s: KPI %(kpi)s, штраф %(penalty)s (%(user)s)."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift_line.py:0
msgid ""
"%s hali yakunlanmagan: natijani smena ichida o'zgartiring (yangi yozuv), "
"tuzatish faqat yakunlangan buyurtma uchun."
msgstr ""
"%s ещё не завершён: измените результат внутри смены (новая запись), "
"корректировка — только для завершённого заказа."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/floor.py:0
msgid ""
"%s hozirgina xuddi shu mahsulot va miqdor bilan yaratildi. Ikkinchi marta "
"bosilgan bo'lsa — kerak emas."
msgstr ""
"%s только что создан с тем же товаром и количеством. Если нажали второй раз "
"— он не нужен."

#. module: cst_kerama_shift
#. odoo-javascript
