#. odoo-python
#: code:addons/cst_kerama_shift/models/shift.py:0
msgid "%(dept)s bo'limida %(date)s kuni %(shift)s allaqachon ochilgan."
msgstr "В цехе %(dept)s смена %(shift)s на %(date)s уже открыта."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/floor.py:0
msgid "%(dept)s · %(shift)s"
msgstr "%(dept)s · %(shift)s"

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/department.py:0
msgid "%(dept)s — %(day)s natijalari"
msgstr "%(dept)s — итоги за %(day)s"

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/floor.py:0
msgid "%(mo)s: o'chirib bo'lmaydi — %(why)s."
msgstr "%(mo)s: удалить нельзя — %(why)s."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift_line.py:0
msgid ""
"%(order)s: %(total)s dona kiritildi, buyurtmada esa %(left)s dona qoldi. "
"Ortiqcha chiqarilgan bo'lsa buyurtma miqdorini oshiring."
msgstr ""
"%(order)s: введено %(total)s шт., а в заказе осталось %(left)s шт. Если "
"выпущено больше, увеличьте количество в заказе."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift_line.py:0
msgid ""
"%(order)s: buyurtmada %(qty)s dona qoldi, undan ko'p kiritildi (%(over)s "
"dona ortiqcha). Ortiqcha chiqarilgan bo'lsa avval buyurtma miqdorini "
"oshiring."
msgstr ""
"%(order)s: в заказе осталось %(qty)s шт., введено больше (лишних %(over)s "
"шт.). Если выпущено больше, сначала увеличьте количество в заказе."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift_line.py:0
msgid ""
"%(product)s: %(qty)s %(uom)s brakka chiqarish uchun %(loc)s joyida yetarli "
"qoldiq yo'q."
msgstr ""
"%(product)s: в местоположении %(loc)s недостаточно остатка для списания в "
"брак %(qty)s %(uom)s."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift_line.py:0
msgid ""
"%(product)s: %(qty)s dona brakka chiqarish uchun %(loc)s joyida yetarli "
"qoldiq yo'q."
msgstr ""
"%(product)s: в местоположении %(loc)s недостаточно остатка для списания в "
"брак %(qty)s шт."

#. module: cst_kerama_shift
#. odoo-python
#: code:addons/cst_kerama_shift/models/shift_line.py:0
