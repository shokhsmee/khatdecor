#. module: cst_kerama_shift
#: model:ir.model.fields,field_description:cst_kerama_shift.field_cst_shift_kpi_rate__rate
msgid "1 dona 1-sort uchun"
msgstr "За 1 шт. 1-го сорта"

#. module: cst_kerama_shift
#: model_terms:ir.actions.act_window,help:cst_kerama_shift.action_kpi_rates
msgid ""
"1 dona 1-sort uchun KPI: bo'lim, liniya, mahsulot yoki kategoriya bo'yicha. Eng aniq stavka\n"
"               ishlatiladi (mahsulot+liniya → mahsulot → kategoriya+liniya → kategoriya → liniya → bo'lim).\n"
"               Bu faqat HR uchun taklif: «Stavkadan to'ldirish» tugmasi xodim ulushi × stavkani yozadi."
msgstr ""
"KPI за 1 шт. 1-го сорта: по цеху, линии, товару или категории. Используется самая точная ставка\n"
"               (товар+линия → товар → категория+линия → категория → линия → цех).\n"
"               Это только предложение для HR: кнопка «Заполнить по ставке» записывает долю сотрудника × ставку."

#. module: cst_kerama_shift
#: model:ir.model.fields,help:cst_kerama_shift.field_cst_production_shift_template__sequence
msgid "1, 2, 3 — oylik hisobotidagi «Smena» ustuniga shu raqam ketadi."
msgstr "1, 2, 3 — этот номер попадает в колонку «Смена» отчёта по зарплате."

#. module: cst_kerama_shift
#: model_terms:ir.actions.act_window,help:cst_kerama_shift.action_shift_templates
msgid ""
"1-smena 06:00–14:00, 2-smena 14:00–22:00, 3-smena 22:00–06:00. Soatlarni shu"
" yerda o'zgartiring; tungi smena boshlangan kuniga yoziladi."
msgstr ""
"1-я смена 06:00–14:00, 2-я смена 14:00–22:00, 3-я смена 22:00–06:00. Часы "
"меняйте здесь; ночная смена записывается на день начала."

