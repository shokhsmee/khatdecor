<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: groups hang off res.groups.privilege, not ir.module.category. -->
    <record id="privilege_shift" model="res.groups.privilege">
        <field name="name">Smena boshqaruvi</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
        <field name="description">Kim smena ochadi, yopadi va bo'limlarni sozlaydi.</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_shift_manager" model="res.groups">
        <field name="name">Bo'lim menejeri</field>
        <field name="privilege_id" ref="privilege_shift"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user')), (4, ref('stock.group_stock_user'))]"/>
        <field name="comment">O'z bo'limida smena ochadi va yopadi, buyurtmalarni liniyaga qo'yadi, natija kiritadi.</field>
    </record>

    <record id="group_shift_admin" model="res.groups">
        <field name="name">Ishlab chiqarish rahbari</field>
        <field name="privilege_id" ref="privilege_shift"/>
        <field name="implied_ids" eval="[(4, ref('group_shift_manager')), (4, ref('mrp.group_mrp_manager'))]"/>
        <field name="comment">Hamma bo'limni ko'radi, bo'lim va smena vaqtlarini sozlaydi, yopilgan smenani qayta ochadi.</field>
    </record>

    <record id="group_shift_admin" model="res.groups">
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- «Tuzatish»: done shift results and done internal transfers. Administrator
         (base.group_system) and the Rahbar role (linked in cst_kerama_dispatch). -->
    <record id="group_doc_correction" model="res.groups">
        <field name="name">Yakunlangan hujjatlarni tuzatish</field>
        <field name="privilege_id" ref="privilege_shift"/>
        <field name="implied_ids" eval="[(4, ref('group_shift_admin'))]"/>
        <field name="comment">Bajarilgan ichki ko'chirish va yakunlangan smena natijasini sabab bilan tuzatadi (ombor qarshi hujjat bilan tuzatiladi).</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_doc_correction'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_shift_manager" model="ir.rule">
            <field name="name">Smena: menejer o'z bo'limini ko'radi</field>
            <field name="model_id" ref="model_cst_production_shift"/>
            <field name="groups" eval="[(4, ref('group_shift_manager'))]"/>
            <field name="domain_force">['|', ('manager_id', '=', user.id), ('department_id.manager_user_ids', 'in', [user.id])]</field>
        </record>
        <record id="rule_shift_admin" model="ir.rule">
            <field name="name">Smena: rahbar hammasini ko'radi</field>
            <field name="model_id" ref="model_cst_production_shift"/>
            <field name="groups" eval="[(4, ref('group_shift_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_shift_line_manager" model="ir.rule">
            <field name="name">Smena buyurtmasi: menejer o'z bo'limi</field>
            <field name="model_id" ref="model_cst_production_shift_line"/>
            <field name="groups" eval="[(4, ref('group_shift_manager'))]"/>
            <field name="domain_force">['|', ('shift_id.manager_id', '=', user.id), ('department_id.manager_user_ids', 'in', [user.id])]</field>
        </record>
        <record id="rule_shift_line_admin" model="ir.rule">
            <field name="name">Smena buyurtmasi: rahbar</field>
            <field name="model_id" ref="model_cst_production_shift_line"/>
            <field name="groups" eval="[(4, ref('group_shift_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_shift_entry_manager" model="ir.rule">
            <field name="name">Smena natijasi: menejer o'z bo'limi</field>
            <field name="model_id" ref="model_cst_production_shift_entry"/>
            <field name="groups" eval="[(4, ref('group_shift_manager'))]"/>
            <field name="domain_force">['|', ('shift_id.manager_id', '=', user.id), ('department_id.manager_user_ids', 'in', [user.id])]</field>
        </record>
        <record id="rule_shift_entry_admin" model="ir.rule">
            <field name="name">Smena natijasi: rahbar</field>
            <field name="model_id" ref="model_cst_production_shift_entry"/>
            <field name="groups" eval="[(4, ref('group_shift_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>

    <!-- multi-company (ТЗ 1): each company sees its own production -->
    <record id="rule_department_company" model="ir.rule">
        <field name="name">Bo'lim: kompaniya</field>
        <field name="model_id" ref="model_cst_production_department"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shift_c_company" model="ir.rule">
        <field name="name">Smena: kompaniya</field>
        <field name="model_id" ref="model_cst_production_shift"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shift_line_c_company" model="ir.rule">
        <field name="name">Smena qatori: kompaniya</field>
        <field name="model_id" ref="model_cst_production_shift_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shift_template_c_company" model="ir.rule">
        <field name="name">Smena vaqti: kompaniya</field>
        <field name="model_id" ref="model_cst_production_shift_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shift_worker_c_company" model="ir.rule">
        <field name="name">Smena xodimi: kompaniya</field>
        <field name="model_id" ref="model_cst_production_shift_worker"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_kpi_rate_c_company" model="ir.rule">
        <field name="name">KPI stavkasi: kompaniya</field>
        <field name="model_id" ref="model_cst_shift_kpi_rate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
