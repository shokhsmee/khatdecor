<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hik_attendance_subscriber_list" model="ir.ui.view">
        <field name="name">hikvision.attendance.subscriber.list</field>
        <field name="model">hikvision.attendance.subscriber</field>
        <field name="arch" type="xml">
            <list string="Bot Subscribers">
                <field name="display_name"/>
                <field name="telegram_username"/>
                <field name="chat_id"/>
                <field name="registered_at"/>
                <field name="last_notified"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hik_attendance_subscriber_form" model="ir.ui.view">
        <field name="name">hikvision.attendance.subscriber.form</field>
        <field name="model">hikvision.attendance.subscriber</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="display_name" readonly="1"/>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="telegram_username"/>
                        <field name="chat_id" readonly="1"/>
                        <field name="active"/>
                        <field name="registered_at" readonly="1"/>
                        <field name="last_notified" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hik_attendance_subscriber" model="ir.actions.act_window">
        <field name="name">Bot Subscribers</field>
        <field name="res_model">hikvision.attendance.subscriber</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hik_attendance_bot_root"
              name="Attendance Bot"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="90"/>

    <menuitem id="menu_hik_attendance_subscriber"
              name="Subscribers"
              parent="menu_hik_attendance_bot_root"
              action="action_hik_attendance_subscriber"
              sequence="10"/>

</odoo>
