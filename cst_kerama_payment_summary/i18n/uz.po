#. module: cst_kerama_payment_summary
#: model:ir.model.fields,help:cst_kerama_payment_summary.field_sale_order__payment_amount_due
msgid ""
"Order total still owed: order total minus every payment already received, "
"including the ones still waiting for approval."
msgstr ""
"Buyurtma bo‘yicha qolgan qarz: buyurtmaning umumiy summasidan allaqachon "
"qabul qilingan barcha to‘lovlar, jumladan hali tasdiqlash kutilayotganlari "
"ham ayirilgan holda."

#. module: cst_kerama_payment_summary
#: model:ir.model.fields,field_description:cst_kerama_payment_summary.field_sale_order__payment_has_waiting
