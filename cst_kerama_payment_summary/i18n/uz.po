msgstr "Kutilayotgan to‘lov bor"

#. module: cst_kerama_payment_summary
#: model:ir.model.fields,help:cst_kerama_payment_summary.field_sale_order__payment_waiting_html
msgid ""
"Payments registered but not yet confirmed (In Process), shown per currency."
msgstr ""
"Ro‘yxatdan o‘tgan, lekin hali tasdiqlanmagan (Jarayonda) to‘lovlar, har bir "
"valyuta bo‘yicha ko‘rsatilgan."

#. module: cst_kerama_payment_summary
#: model:ir.model.fields,help:cst_kerama_payment_summary.field_sale_order__payment_waiting_total
msgid "Pending (In Process) payments converted to the order currency."
msgstr "Kutilayotgan (Jarayonda) to‘lovlar buyurtma valyutasiga aylantirilgan."

