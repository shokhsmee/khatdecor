<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- «196-10/k»: the number comes from here, the month and the /k are
             added by the event.  Restarted by hand every January, the way the
             department has always numbered its orders. -->
        <record id="seq_hr_event_order" model="ir.sequence">
            <field name="name">Kadr buyrug'i raqami</field>
            <field name="code">cst.hr.event.order</field>
            <field name="implementation">no_gap</field>
            <field name="padding">1</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range" eval="True"/>
        </record>

        <record id="seq_hr_event_contract" model="ir.sequence">
            <field name="name">Mehnat shartnomasi raqami</field>
            <field name="code">cst.hr.event.contract</field>
            <field name="implementation">no_gap</field>
            <field name="padding">1</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>
