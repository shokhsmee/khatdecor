<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_bg" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.bg</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting string="Login Screen Background Image"
                         help="Choose a custom background for the POS login screen">
                    <field name="pos_login_screen_background" widget="image"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>