<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payroll_period_list" model="ir.ui.view">
        <field name="name">cst.payroll.period.list</field>
        <field name="model">cst.payroll.period</field>
        <field name="arch" type="xml">
            <list string="Payroll Periods" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="employee_count" string="Employees"/>
                <field name="total_accrued" sum="Accrued"/>
                <field name="total_deducted" sum="Deducted"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state in ('posted', 'closed')"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_period_form" model="ir.ui.view">
        <field name="name">cst.payroll.period.form</field>
        <field name="model">cst.payroll.period</field>
        <field name="arch" type="xml">
            <form string="Payroll Period">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="btn-primary" invisible="state not in ('draft', 'computed')"
                            help="Generate salary and KPI lines. Hand-entered lines are kept."/>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state not in ('draft', 'computed')"/>
                    <button name="action_post" type="object" string="Post to Accounting"
                            class="btn-primary" invisible="state != 'confirmed'"
                            confirm="This creates the journal entry for the whole period. Continue?"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'posted'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state != 'closed'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state in ('draft', 'closed')"
                            confirm="A posted period is reversed, not erased — the journal entry stays in the ledger with a reversal against it. Continue?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,confirmed,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_advances" type="object" class="oe_stat_button"
                                icon="fa-money">
                            <field name="advance_count" widget="statinfo" string="Avanslar"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button"
                                icon="fa-check-square-o">
                            <field name="payment_count" widget="statinfo" string="To'lovlar"/>
                        </button>
                        <button name="action_view_lines" type="object" class="oe_stat_button"
                                icon="fa-list-ul">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                        <button name="action_view_move" type="object" class="oe_stat_button"
                                icon="fa-book" invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal</span>
                                <span class="o_stat_text">Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not date_warning">
                        <field name="date_warning" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ноябрь 2026"/></h1>
                    </div>
                    <div class="o_cst_payroll_cards" name="cards" invisible="not line_count">
                        <div class="o_cst_card">
                            <span class="o_cst_card_label">Jami hisoblandi</span>
                            <field name="sum_accrued" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_cst_card o_cst_card_info">
                            <span class="o_cst_card_label">Avans berilgan</span>
                            <field name="sum_advance" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_cst_card">
                            <span class="o_cst_card_label">To'lanadi (avanssiz)</span>
                            <field name="sum_to_pay" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_cst_card">
                            <span class="o_cst_card_label">To'langan</span>
                            <field name="sum_paid" readonly="1" nolabel="1"/>
                        </div>
                        <div class="o_cst_card o_cst_card_warn">
                            <span class="o_cst_card_label">Qoldiq (qarz)</span>
                            <field name="sum_balance" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="date_posted"/>
                            <field name="is_foreign_pay" invisible="1"/>
                            <label for="cst_rate" invisible="not is_foreign_pay"/>
                            <div class="o_row" invisible="not is_foreign_pay">
                                <span>1 <field name="company_currency_id" class="oe_inline" readonly="1" options="{'no_open': True}"/> =</span>
                                <field name="cst_rate" class="oe_inline" readonly="state not in ('draft', 'computed')"/>
                                <field name="currency_id" class="oe_inline" readonly="1" options="{'no_open': True}"/>
                            </div>
                        </group>
                        <group>
                            <field name="employee_count"/>
                            <field name="total_accrued"/>
                            <field name="total_deducted"/>
                            <field name="total_employer"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Xodimlar" name="employees" invisible="not line_count">
                            <div class="d-flex justify-content-end gap-2 mb-2">
                                <button name="action_view_employees" type="object" class="btn btn-secondary btn-sm"
                                        icon="fa-filter" string="Filtr bilan ochish"
                                        help="Qoldig'i bor / To'langan / Avanssiz / Rasmiy filtrlari va bo'lim bo'yicha guruhlash"/>
                            </div>
                            <field name="employee_summary_ids" nolabel="1" readonly="1"
                                   context="{'form_view_ref': 'cst_kerama_payroll.view_payroll_period_employee_form'}">
                                <list decoration-success="pay_state == 'paid'" decoration-danger="pay_state == 'over'"
                                      decoration-bf="balance &gt; 0" create="0" delete="0">
                                    <field name="employee_id"/>
                                    <field name="department_id" optional="hide"/>
                                    <field name="oklad" sum="Jami"/>
                                    <field name="kpi" sum="Jami"/>
                                    <field name="accrued" sum="Jami"/>
                                    <field name="advance" sum="Jami"/>
                                    <field name="withheld" sum="Jami"/>
                                    <field name="to_pay" sum="Jami"/>
                                    <field name="paid" sum="Jami"/>
                                    <field name="balance" sum="Jami"/>
                                    <field name="has_official" optional="hide" widget="boolean"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="pay_state" widget="badge"
                                           decoration-success="pay_state == 'paid'"
                                           decoration-warning="pay_state in ('unpaid', 'partial')"
                                           decoration-danger="pay_state == 'over'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Avanslar" name="advances" invisible="not advance_count">
                            <field name="advance_line_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="date"/>
                                    <field name="employee_id"/>
                                    <field name="component_id"/>
                                    <field name="name"/>
                                    <field name="source_ref" optional="show"/>
                                    <field name="amount" sum="Jami"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="To'lovlar" name="payments" invisible="not payment_count">
                            <field name="payment_line_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="date"/>
                                    <field name="employee_id"/>
                                    <field name="component_id"/>
                                    <field name="name"/>
                                    <field name="source_ref" optional="show"/>
                                    <field name="amount" sum="Jami"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Komponentlar" name="lines">
                            <field name="line_ids" nolabel="1"
                                   context="{'default_period_id': id, 'default_company_id': company_id, 'default_date': date_to}">
                                <list editable="bottom"
                                      decoration-success="kind == 'accrual'"
                                      decoration-danger="kind == 'deduction'">
                                    <field name="employee_id"/>
                                    <field name="component_id"/>
                                    <field name="kind" optional="show"/>
                                    <field name="date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="is_official" widget="boolean_toggle" optional="show"/>
                                    <field name="quantity" optional="hide"/>
                                    <field name="rate" optional="hide"/>
                                    <field name="source_ref" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="state" widget="badge" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- «Xodimlar»: one row per employee of a period -->
    <record id="view_payroll_period_employee_list" model="ir.ui.view">
        <field name="name">cst.payroll.period.employee.list</field>
        <field name="model">cst.payroll.period.employee</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-success="pay_state == 'paid'" decoration-danger="pay_state == 'over'">
                <field name="period_id" optional="hide"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="oklad" sum="Jami"/>
                <field name="kpi" sum="Jami"/>
                <field name="accrued" sum="Jami"/>
                <field name="advance" sum="Jami"/>
                <field name="withheld" sum="Jami"/>
                <field name="to_pay" sum="Jami"/>
                <field name="paid" sum="Jami"/>
                <field name="balance" sum="Jami"/>
                <field name="has_official" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="pay_state" widget="badge"
                       decoration-success="pay_state == 'paid'"
                       decoration-warning="pay_state in ('unpaid', 'partial')"
                       decoration-danger="pay_state == 'over'"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_period_employee_search" model="ir.ui.view">
        <field name="name">cst.payroll.period.employee.search</field>
        <field name="model">cst.payroll.period.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="period_id"/>
                <filter name="with_balance" string="Qoldig'i bor" domain="[('balance', '>', 0)]"/>
                <filter name="paid" string="To'langan" domain="[('pay_state', '=', 'paid')]"/>
                <filter name="over" string="Ortiqcha olgan" domain="[('pay_state', '=', 'over')]"/>
                <filter name="no_advance" string="Avanssiz" domain="[('has_advance', '=', False)]"/>
                <filter name="official" string="Rasmiy" domain="[('has_official', '=', True)]"/>
                <group>
                    <filter name="group_department" string="Bo'lim" context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="Holati" context="{'group_by': 'pay_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_payroll_period_employee_form" model="ir.ui.view">
        <field name="name">cst.payroll.period.employee.form</field>
        <field name="model">cst.payroll.period.employee</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-list-ul"
                                string="Qatorlar"/>
                    </div>
                    <div class="oe_title">
                        <h2><field name="employee_id" readonly="1"/> · <field name="period_id" readonly="1"/></h2>
                    </div>
                    <div class="o_cst_payroll_cards">
                        <div class="o_cst_card"><span class="o_cst_card_label">Jami hisoblandi</span><field name="accrued"/></div>
                        <div class="o_cst_card o_cst_card_info"><span class="o_cst_card_label">Avans</span><field name="advance"/></div>
                        <div class="o_cst_card"><span class="o_cst_card_label">Ushlanma</span><field name="withheld"/></div>
                        <div class="o_cst_card"><span class="o_cst_card_label">To'langan</span><field name="paid"/></div>
                        <div class="o_cst_card o_cst_card_warn"><span class="o_cst_card_label">Qoldiq</span><field name="balance"/></div>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group string="Hisoblangan komponentlar">
                            <field name="accrual_line_ids" nolabel="1" colspan="2" readonly="1">
                                <list>
                                    <field name="component_id"/>
                                    <field name="date" optional="hide"/>
                                    <field name="amount" sum="Jami hisoblandi"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </group>
                        <group string="Avans, ushlanma va to'lovlar">
                            <field name="money_line_ids" nolabel="1" colspan="2" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="component_id"/>
                                    <field name="source_ref" optional="show"/>
                                    <field name="amount" sum="Jami"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payroll_period" model="ir.actions.act_window">
        <field name="name">Payroll Periods</field>
        <field name="res_model">cst.payroll.period</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Open a payroll month</p>
            <p>Compute generates the salary and KPI lines. Nothing reaches the
               ledger until you confirm and post.</p>
        </field>
    </record>

</odoo>
