<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ bonus / jarima ============ -->
    <record id="view_payroll_entry_wizard_form" model="ir.ui.view">
        <field name="name">cst.payroll.entry.wizard.form</field>
        <field name="model">cst.payroll.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Bonus / jarima yozish">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="component_id" options="{'no_create': True}"/>
                        <field name="kind" invisible="1"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="period_id" options="{'no_create': True}"/>
                        <field name="note" placeholder="Masalan: 12-vagon tushirish"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>

                <group string="Ko'p xodimga birdan">
                    <group>
                        <field name="employee_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="default_amount"/>
                        <button name="action_fill" type="object" string="Qatorlarga qo'shish"
                                class="btn-secondary" invisible="not employee_ids"/>
                    </group>
                </group>

                <field name="line_ids">
                    <list editable="bottom">
                        <field name="company_id" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="employee_id" options="{'no_create': True}"/>
                        <field name="balance" readonly="1" optional="show"/>
                        <field name="amount" sum="Jami"/>
                        <field name="note" optional="show"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer oe_right">
                    <field name="total"/>
                </group>
                <div class="text-muted">
                    Кулда ёзилган каторлар давр кайта хисобланганда учирилмайди.
                </div>
                <footer>
                    <button name="action_create" type="object" string="Yozish"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Bekor qilish" special="cancel"
                            class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payroll_entry_wizard" model="ir.actions.act_window">
        <field name="name">Bonus / jarima yozish</field>
        <field name="res_model">cst.payroll.entry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============ kartaga o'tkazmalar ============ -->
    <record id="view_payroll_card_import_wizard_form" model="ir.ui.view">
        <field name="name">cst.payroll.card.import.wizard.form</field>
        <field name="model">cst.payroll.card.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Kartaga o'tkazilgan pullarni yuklash">
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>

                <div invisible="state != 'upload'">
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="component_id" options="{'no_create': True}"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="period_id" options="{'no_create': True}"/>
                            <field name="file" filename="file_name" widget="binary"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Excel файлда камида икки устун булиши керак:
                        <b>PINFL</b> (ёки ЖШШИР) ва <b>Summa</b> (ёки Сумма).
                        Хохласангиз <b>FIO</b> устуни хам булсин — у факат
                        текшириш учун курсатилади.
                        Ходим айнан <b>ЖШШИР</b> буйича топилади, исм буйича эмас.
                    </div>
                </div>

                <div invisible="state != 'preview'">
                    <group>
                        <group>
                            <field name="matched_count" string="Topildi" readonly="1"/>
                            <field name="matched_total" string="Jami summa" readonly="1"/>
                        </group>
                        <group>
                            <field name="unmatched_count" string="Topilmadi" readonly="1"/>
                            <field name="duplicate_count" string="Takror shubhasi" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="unmatched_count == 0">
                        Топилмаган каторлар <b>юкланмайди</b>.  Ходим картасида
                        ЖШШИР тулдирилганини текширинг ёки каторда ходимни
                        кулда танланг.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="duplicate_count == 0">
                        Диккат: шу кун учун айнан шундай каторлар аллакачон бор.
                        Файл иккинчи марта юкланаётган булиши мумкин.
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" create="0"
                              decoration-danger="state == 'unmatched'"
                              decoration-warning="is_duplicate">
                            <field name="company_id" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="pinfl" readonly="1"/>
                            <field name="file_name_text" readonly="1"/>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="amount" sum="Jami"/>
                            <field name="is_duplicate" readonly="1" optional="show"/>
                            <field name="reason" readonly="1"/>
                            <field name="state" readonly="1" widget="badge"
                                   decoration-success="state == 'matched'"
                                   decoration-danger="state == 'unmatched'"/>
                        </list>
                    </field>
                </div>

                <footer>
                    <button name="action_parse" type="object" string="Tekshirish"
                            class="btn-primary" invisible="state != 'upload'"
                            data-hotkey="q"/>
                    <button name="action_confirm" type="object" string="Yuklash"
                            class="btn-primary" invisible="state != 'preview'"
                            confirm="Топилган каторлар ойлик хисобига ёзилади.  Давом этамизми?"
                            data-hotkey="q"/>
                    <button name="action_back" type="object" string="Orqaga"
                            class="btn-secondary" invisible="state != 'preview'"/>
                    <button string="Bekor qilish" special="cancel"
                            class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payroll_card_import_wizard" model="ir.actions.act_window">
        <field name="name">Kartaga o'tkazmalarni yuklash (Excel)</field>
        <field name="res_model">cst.payroll.card.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
