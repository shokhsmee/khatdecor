msgstr "Xodimlar oyligi bo'yicha batafsil hisobot"

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/wizard/payroll_card_import_wizard.py:0
msgid "Шу кунги айнан шундай катор аллакачон бор"
msgstr "Shu kungi aynan shunday qator allaqachon bor"

#. module: cst_kerama_payroll
#: model:ir.model.fields,help:cst_kerama_payroll.field_mrp_routing_workcenter__cst_kpi_rate
msgid ""
"Шу операцияни шу махсулот учун бажарган ходим бир дона тайёр махсулот учун оладиган сумма.  Ноль булса — бу операция учун ишбай хисобланмайди.\n"
"\n"
"Ставка узгартирилса, факат кейинги хисоблашларга таъсир килади: хисобланган хар бир катор уз ставкасини саклаб колади."
msgstr ""
"Shu operatsiyani shu mahsulot uchun bajargan xodim bir dona tayyor mahsulot uchun oladigan summa.  Nol bo'lsa — bu operatsiya uchun ishbay hisoblanmaydi.\n"
"\n"
"Stavka o'zgartirilsa, faqat keyingi hisoblashlarga ta'sir qiladi: hisoblangan har bir qator o'z stavkasini saqlab qoladi."

#. module: cst_kerama_payroll
#: model:ir.model.fields,help:cst_kerama_payroll.field_cst_picking_unloader__amount
msgid "Шу ходимга шу юкни туширганлик учун туланадиган сумма."
msgstr "Shu xodimga shu yukni tushirganlik uchun to'lanadigan summa."

#. module: cst_kerama_payroll
#: model:ir.model.fields,help:cst_kerama_payroll.field_res_company__cst_unload_rate_default
#: model:ir.model.fields,help:cst_kerama_payroll.field_res_config_settings__cst_unload_rate_default
msgid ""
"Юк туширган хар бир ходим учун таклиф килинадиган сумма.  Хужжатда "
"узгартириш мумкин — бу факат бошлангич киймат."
msgstr ""
"Yuk tushirgan har bir xodim uchun taklif qilinadigan summa.  Hujjatda "
"o'zgartirish mumkin — bu faqat boshlang'ich qiymat."

#. module: cst_kerama_payroll
#: model:cst.payroll.component,name:cst_kerama_payroll.component_yuk_tushirish
msgid "Юк тушириш"
msgstr "Yuk tushirish"

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/models/payroll_period.py:0
msgid "Юк тушириш: KPI олмайдиган ходимлар"
msgstr "Yuk tushirish: KPI olmaydigan xodimlar"

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/wizard/payroll_card_import_wizard.py:0
msgid "Юкланди — %s ta qator"
msgstr "Yuklandi — %s ta qator"

#. module: cst_kerama_payroll
#. odoo-javascript
#: code:addons/cst_kerama_payroll/static/src/payroll_report/payroll_report.xml:0
msgid "Янгилаш"
msgstr "Yangilash"

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/models/payroll_period.py:0
msgid ""
"иш буюртмаси кулда кушилган ва махсулотнинг хеч бир спецификациясида шу "
"номли операция мавжуд эмас — операцияни спецификацияга кушиб, ставкасини "
"белгиланг"
msgstr ""
"ish buyurtmasi qo'lda qo'shilgan va mahsulotning hech bir texkartasida shu "
"nomli operatsiya mavjud emas — operatsiyani texkartaga qo'shib, stavkasini "
"belgilang"

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/models/payroll_period.py:0
msgid "иш буюртмасида таймер босилмаган ва ходим тайинланмаган"
msgstr "ish buyurtmasida taymer bosilmagan va xodim tayinlanmagan"

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/models/payroll_period.py:0
msgid "иш хаки схемаси KPI'ни уз ичига олмайди ёки бошка компанияда"
msgstr "ish haqi sxemasi KPI'ni o'z ichiga olmaydi yoki boshqa kompaniyada"

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/models/payroll_period.py:0
msgid "махсулот картасидаги «Sotuv KPI» майдонини тулдиринг"
msgstr "mahsulot kartasidagi «Sotuv KPI» maydonini to'ldiring"

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/models/payroll_period.py:0
msgid ""
"спецификация (BoM) ичидаги операция каторида «Ishbay KPI» майдонини "
"тулдиринг"
msgstr ""
"texkarta (BoM) ichidagi operatsiya qatorida «Ishbay KPI» maydonini "
"to'ldiring"

