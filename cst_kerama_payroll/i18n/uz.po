#: code:addons/cst_kerama_payroll/models/payroll_line.py:0
msgid ""
"%s has no work contact, so the payable line cannot name a partner.  Set one "
"on the employee form."
msgstr ""
"%s uchun ish kontakti yo'q, shuning uchun qarz qatorida hamkorni ko'rsatib "
"bo'lmaydi.  Uni xodim kartasida belgilang."

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/models/payroll_component.py:0
msgid ""
"%s is marked taxable but not official.  Only the official stream is taxed — "
"untick one of the two."
msgstr ""
"%s soliqqa tortiladi deb belgilangan, lekin rasmiy emas.  Faqat rasmiy oqim "
"soliqqa tortiladi — ikkalasidan birini olib tashlang."

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/models/payroll_line.py:0
msgid ""
"%s posted line(s) cannot be deleted.  Reset the period to draft first — that"
" cancels the journal entry."
msgstr ""
"%s ta o'tkazilgan qatorni o'chirib bo'lmaydi.  Avval davrni qoralamaga "
"qaytaring — bu buxgalteriya provodkasini bekor qiladi."

#. module: cst_kerama_payroll
#. odoo-python
#: code:addons/cst_kerama_payroll/models/res_company.py:0
msgid ""
"%s: oylik qatorlari allaqachon bor — oylik valyutasini endi o'zgartirib "
"bo'lmaydi (eski summalar boshqa valyutada qolib ketadi)."
msgstr ""
"%s: oylik qatorlari allaqachon bor — oylik valyutasini endi o'zgartirib "
"bo'lmaydi (eski summalar boshqa valyutada qolib ketadi)."

#. module: cst_kerama_payroll
#: model:ir.model.fields,help:cst_kerama_payroll.field_cst_payroll_period__cst_rate
