<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Odoo 19: groups hang off res.groups.privilege, not ir.module.category. -->
        <record id="privilege_khatdecor_payroll" model="res.groups.privilege">
            <field name="name">Khatdecor Payroll</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="description">Who may see and run the salary ledger.</field>
            <field name="sequence">40</field>
        </record>

        <record id="group_payroll_user" model="res.groups">
            <field name="name">Payroll Officer</field>
            <field name="privilege_id" ref="privilege_khatdecor_payroll"/>
            <field name="comment">May enter bonuses, fines and advances, and read
                the salary reports.  Cannot post to the ledger.</field>
        </record>

        <record id="group_payroll_manager" model="res.groups">
            <field name="name">Payroll Manager</field>
            <field name="privilege_id" ref="privilege_khatdecor_payroll"/>
            <field name="implied_ids" eval="[Command.link(ref('group_payroll_user'))]"/>
            <field name="comment">May configure components and rates, compute a
                period and post it to accounting.</field>
        </record>

        <record id="group_payroll_manager" model="res.groups">
            <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
        </record>

        <!-- A payroll officer sees only their own company's lines. -->
        <record id="rule_payroll_line_company" model="ir.rule">
            <field name="name">Payroll line: own companies</field>
            <field name="model_id" ref="model_cst_payroll_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_payroll_period_company" model="ir.rule">
            <field name="name">Payroll period: own companies</field>
            <field name="model_id" ref="model_cst_payroll_period"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_picking_unloader_company" model="ir.rule">
            <field name="name">Unloading payment: own companies</field>
            <field name="model_id" ref="model_cst_picking_unloader"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
