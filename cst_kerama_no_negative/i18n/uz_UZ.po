#. module: cst_kerama_no_negative
#. odoo-python
#: code:addons/cst_kerama_no_negative/models/stock_picking.py:0
msgid ""
"Scrapping would take stock below zero:\n"
"\n"
"  • %(product)s in %(location)s: need %(needed).2f, have %(available).2f\n"
"\n"
"Receive or correct the stock first, or ask someone with the \"Allow Negative Stock\" right to do it."
msgstr ""
"Hisobdan chiqarish ombor qoldig'ini manfiyga olib keladi:\n"
"\n"
"  • %(product)s — %(location)s: kerak %(needed).2f, mavjud %(available).2f\n"
"\n"
"Avval tovarni kirim qiling yoki qoldiqni to'g'rilang, aks holda \"Manfiy qoldiqqa ruxsat\" huquqiga ega xodimdan so'rang."

#. module: cst_kerama_no_negative
#: model:ir.model,name:cst_kerama_no_negative.model_stock_move
msgid "Stock Move"
msgstr ""

#. module: cst_kerama_no_negative
#. odoo-python
#: code:addons/cst_kerama_no_negative/models/stock_quant.py:0
msgid ""
"Stock cannot go negative.\n"
"\n"
"%(product)s in %(location)s would end at %(qty).2f %(uom)s.\n"
"\n"
"Receive or correct the stock first, or ask someone with the \"Allow Negative Stock\" right to do it."
msgstr ""
"Ombor qoldig'i manfiy bo'la olmaydi.\n"
"\n"
"%(product)s — %(location)s da %(qty).2f %(uom)s bo'lib qoladi.\n"
"\n"
"Avval tovarni kirim qiling yoki qoldiqni to'g'rilang, aks holda \"Manfiy qoldiqqa ruxsat\" huquqiga ega xodimdan so'rang."

#. module: cst_kerama_no_negative
#. odoo-python
#: code:addons/cst_kerama_no_negative/models/account_move.py:0
msgid ""
"The cash box cannot go negative.\n"
"\n"
"%(account)s would end at %(balance).2f %(currency)s.\n"
"\n"
"Register the incoming cash first, or ask someone with the \"Allow Negative Cash\" right to post this."
msgstr ""
"Kassa qoldig'i manfiy bo'la olmaydi.\n"
"\n"
"%(account)s hisobida %(balance).2f %(currency)s bo'lib qoladi.\n"
"\n"
"Avval kassaga kirimni qayd eting, aks holda \"Manfiy kassaga ruxsat\" huquqiga ega xodimdan so'rang."

