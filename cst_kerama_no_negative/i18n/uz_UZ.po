#. module: cst_kerama_no_negative
#: model:res.groups,comment:cst_kerama_no_negative.group_allow_negative_cash
msgid ""
"May post journal entries that take a cash\n"
"                account below zero."
msgstr "Kassa hisobini manfiyga olib keladigan provodkalarni qayd eta oladi."

#. module: cst_kerama_no_negative
#: model:res.groups,comment:cst_kerama_no_negative.group_allow_negative_stock
msgid ""
"May validate transfers, scraps and manufacturing\n"
"                orders that take an internal location below zero."
msgstr ""
"Ombor qoldig'ini manfiyga olib keladigan o'tkazmalar, hisobdan chiqarishlar "
"va ishlab chiqarish buyurtmalarini tasdiqlay oladi."

#. module: cst_kerama_no_negative
#: model:ir.model.fields,field_description:cst_kerama_no_negative.field_account_journal__cst_prevent_negative_balance
