msgstr "Manfiy qoldiqni taqiqlash"

#. module: cst_kerama_no_negative
#: model:ir.model,name:cst_kerama_no_negative.model_stock_quant
msgid "Quants"
msgstr ""

#. module: cst_kerama_no_negative
#: model:ir.model.fields,help:cst_kerama_no_negative.field_account_journal__cst_prevent_negative_balance
msgid ""
"Refuse to post an entry that would take this journal's account below zero — "
"a cash box cannot pay out money it does not hold. On by default for cash "
"journals."
msgstr ""
"Ushbu jurnal hisobini manfiyga olib keladigan provodkani qabul qilmaslik — "
"kassa o'zida yo'q pulni chiqara olmaydi. Naqd pul jurnallari uchun sukut "
"bo'yicha yoqilgan."

