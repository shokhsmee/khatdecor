        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_domain_model_erp_manager" model="ir.model.access">
        <field name="name">domain.model.erp.manager</field>
        <field name="model_id" ref="access_roles.model_domain_model"/>
        <field name="group_id" ref="base.group_erp_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_button_registry_erp_manager" model="ir.model.access">
        <field name="name">button.registry.erp.manager</field>
        <field name="model_id" ref="access_roles.model_button_registry"/>
        <field name="group_id" ref="base.group_erp_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_tab_registry_erp_manager" model="ir.model.access">
        <field name="name">tab.registry.erp.manager</field>
        <field name="model_id" ref="access_roles.model_tab_registry"/>
        <field name="group_id" ref="base.group_erp_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_filter_registry_erp_manager" model="ir.model.access">
        <field name="name">filter.registry.erp.manager</field>
        <field name="model_id" ref="access_roles.model_filter_registry"/>
        <field name="group_id" ref="base.group_erp_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_groupby_registry_erp_manager" model="ir.model.access">
        <field name="name">groupby.registry.erp.manager</field>
        <field name="model_id" ref="access_roles.model_groupby_registry"/>
        <field name="group_id" ref="base.group_erp_manager"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
