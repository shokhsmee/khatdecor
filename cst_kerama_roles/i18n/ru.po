#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "%(name)s (copy)"
msgstr "%(name)s (копия)"

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.js:0
msgid "A copy of «%s» was made. Rename it and adjust it."
msgstr "Создана копия «%s». Переименуйте и настройте её."

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
msgid ""
"A person has one role. Their permissions become exactly the permissions of "
"this role when you save; taking them out of the role leaves them with no "
"permissions."
msgstr ""
"У человека одна роль. При сохранении его права становятся ровно правами этой"
" роли; если убрать его из роли, он останется без прав."

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
msgid ""
"A role is a job. Give a person a role and they see that role's apps with "
"that role's permissions."
msgstr ""
"Роль — это должность. Дайте человеку роль, и он увидит приложения этой роли "
"с её правами."

#. module: cst_kerama_roles
#: model:ir.model.fields,help:cst_kerama_roles.field_access_role__cst_description
msgid ""
"A sentence or two about the job this role is meant for, shown in the role "
"builder."
msgstr ""
"Одно-два предложения о должности, для которой роль; показывается в "
"конструкторе ролей."

#. module: cst_kerama_roles
#: model:ir.model,name:cst_kerama_roles.model_res_groups
msgid "Access Groups"
msgstr "Группы доступа"

#. module: cst_kerama_roles
#: model:ir.model,name:cst_kerama_roles.model_access_role
msgid "Access Role"
msgstr "Роль доступа"

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
msgid "Add a person: type a name or login…"
msgstr "Добавить человека: введите имя или логин…"

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
msgid "Administration"
msgstr "Администрирование"

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
msgid ""
"Advanced settings (hiding single buttons, fields or filters) become "
"available after the first save."
msgstr ""
"Расширенные настройки (скрытие отдельных кнопок, полей или фильтров) "
"доступны после первого сохранения."

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
msgid "Advanced: hide single buttons, fields or filters"
msgstr "Расширенно: скрыть отдельные кнопки, поля или фильтры"

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also approves and pays the payroll, sets KPI rates."
msgstr "Также утверждает и выплачивает зарплату, задаёт ставки KPI."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also approves purchases and manages the settings."
msgstr "Также утверждает закупки и управляет настройками."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also bills of materials (texkarta), work centres and settings."
msgstr "Также техкарты, рабочие центры и настройки."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also confirms and reopens cash days, manages cash desks."
msgstr "Также подтверждает и переоткрывает кассовые дни, управляет кассами."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also corrects shifts and transfers that are already finished."
msgstr "Также исправляет уже завершённые смены и перемещения."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also departments, contracts and HR settings."
msgstr "Также отделы, договоры и настройки HR."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also expense categories and settings."
msgstr "Также категории расходов и настройки."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also sets up quality control points."
msgstr "Также настраивает точки контроля качества."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also the attendance settings and devices."
msgstr "Также настройки посещаемости и устройства."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Also works with bank and cash statements."
msgstr "Также работает с банковскими и кассовыми выписками."

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
msgid ""
"An app shows up only when both are true: it is switched on in part 2 and the"
" permission for it is given in part 3. The preview on the right of a role "
"tells you when one of them is missing."
msgstr ""
"Приложение видно, только если выполнены оба условия: оно включено в части 2 "
"и право на него дано в части 3. Предпросмотр справа подскажет, чего не "
"хватает."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Approves everybody's expenses."
msgstr "Утверждает расходы всех."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Approves the expenses of their own team."
msgstr "Утверждает расходы своей команды."

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
msgid "Apps"
msgstr "Приложения"

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.js:0
msgid "At least «%(level)s» comes with «%(source)s»."
msgstr "Как минимум «%(level)s» даётся вместе с «%(source)s»."

#. module: cst_kerama_roles
#: model:ir.model.fields,help:cst_kerama_roles.field_role_management__cst_shown_menu_ids
msgid ""
"Bo'sh bo'lsa — hech narsa o'zgarmaydi. To'ldirilsa, rol egasi faqat shu "
"menyularni, ularning ichidagilarni va ularga olib boradigan yuqori "
"menyularni ko'radi; qolgan ilovalar yashiriladi. Huquqlar (guruhlar) "
"tegilmaydi."
msgstr ""
"Если пусто — ничего не меняется. Если заполнено, владелец роли видит только "
"эти меню, их подменю и ведущие к ним верхние меню; остальные приложения "
"скрываются. Права (группы) не затрагиваются."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Bookkeeper: journal entries, reconciliation, all reports."
msgstr "Бухгалтер: проводки, сверка, все отчёты."

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
msgid "Cards"
msgstr "Карточки"

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Checks the goods leaving at the gate."
msgstr "Проверяет выезжающий товар на воротах."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Confirms the bank account numbers of partners."
msgstr "Подтверждает банковские счета контрагентов."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Creates and edits customers and suppliers."
msgstr "Создаёт и изменяет клиентов и поставщиков."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Creates and edits dashboards."
msgstr "Создаёт и изменяет панели управления."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Creates and edits products and their prices."
msgstr "Создаёт и изменяет товары и их цены."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Creates and edits roles (this screen)."
msgstr "Создаёт и изменяет роли (этот экран)."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Creates invoices and bills and registers payments."
msgstr "Создаёт счета клиентам и поставщикам, регистрирует платежи."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Creates projects and manages their settings."
msgstr "Создаёт проекты и управляет их настройками."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Creates purchase orders and receives the goods."
msgstr "Создаёт заказы на покупку и принимает товар."

#. module: cst_kerama_roles
#. odoo-python
#: code:addons/cst_kerama_roles/models/role_builder.py:0
msgid "Creates quotations and orders and sees only their own."
msgstr "Создаёт предложения и заказы, видит только свои."

#. module: cst_kerama_roles
#. odoo-javascript
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.js:0
#: code:addons/cst_kerama_roles/static/src/role_builder/role_builder.xml:0
