<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Which apps each role sees. Every record below except Nazorat is a
         «shown menus» whitelist: the role sees those menus, what lies under
         them and the parents leading to them, and nothing else. Hiding is
         all it does — the role's groups, and so its access rights, are left
         exactly as they are.

         Jo'natish is linked into the whitelists by cst_kerama_dispatch, which
         depends on this module. Administrator, Nazoratchi and the Jo'natish
         role are not whitelisted here. -->

    <!-- Nazoratchi watches, it does not touch: payroll and accounting menus
         are hidden and every form, list and kanban is served without its
         edit and create buttons. That last part is interface-level only —
         the read-only accounting group is what actually holds on the server
         side. -->
    <record id="rm_controller" model="role.management">
        <field name="name">Nazorat (faqat ko‘rish)</field>
        <field name="is_readonly" eval="True"/>
        <field name="role_ids" eval="[Command.set([ref('role_controller')])]"/>
        <field name="menu_ids" eval="[Command.set([
            ref('cst_kerama_payroll.menu_payroll_root'),
            ref('accountant.menu_accounting'),
            ref('cst_kerama_dashboard.menu_kerama_dashboard_accounting'),
            ref('cst_kerama_reports.menu_reports_finance'),
            ref('cst_kerama_reports.menu_reports_payroll'),
            ref('cst_kerama_reports.menu_reports_cash'),
            ref('cst_kerama_reports.menu_reports_director'),
        ])]"/>
    </record>

    <!-- Rahbar: all of Xisobotlar, Boshqaruv paneli, Qo'ng'iroqlar, Vazifa,
         Kassa, Odoo AI, Xarajatlar -->
    <record id="rm_director" model="role.management">
        <field name="name">Rahbar — faqat o'z ilovalari</field>
        <field name="role_ids" eval="[Command.set([ref('role_director')])]"/>
        <field name="cst_shown_menu_ids" eval="[Command.set([
            ref('cst_kerama_reports.menu_reports_root'),
            ref('cst_kerama_dashboard.menu_kerama_dashboard_root'),
            ref('moizvonki_calls.menu_moizvonki_root'),
            ref('project_todo.menu_todo_todos'),
            ref('cst_kerama_kassa.menu_kassa_root'),
            ref('muk_ai.menu_ai_root'),
            ref('hr_expense.menu_hr_expense_root'),
        ])]"/>
    </record>

    <!-- Sotuv bo'limi boshlig'i: Qo'ng'iroqlar, Xisobotlar (Mijozlar, Ombor),
         Kontaktlar, Sotishlar (+ Jo'natish for «Ichki o'tkazmalar») -->
    <record id="rm_sales_head" model="role.management">
        <field name="name">Sotuv bo'limi boshlig'i — faqat o'z ilovalari</field>
        <field name="role_ids" eval="[Command.set([ref('role_sales_head')])]"/>
        <field name="cst_shown_menu_ids" eval="[Command.set([
            ref('moizvonki_calls.menu_moizvonki_root'),
            ref('cst_kerama_reports.menu_reports_customers'),
            ref('cst_kerama_reports.menu_reports_stock'),
            ref('contacts.menu_contacts'),
            ref('sale.sale_menu_root'),
        ])]"/>
    </record>

    <!-- Sotuv menejeri: Sotishlar, Xisobotlar (Mijozlar), Kontaktlar -->
    <record id="rm_salesperson" model="role.management">
        <field name="name">Sotuv menejeri — faqat o'z ilovalari</field>
        <field name="role_ids" eval="[Command.set([ref('role_salesperson')])]"/>
        <field name="cst_shown_menu_ids" eval="[Command.set([
            ref('sale.sale_menu_root'),
            ref('cst_kerama_reports.menu_reports_customers'),
            ref('contacts.menu_contacts'),
        ])]"/>
    </record>

    <!-- HR: Xodimlar, Davomat, Oylik, Xisobotlar (Oylik), Qo'ng'iroqlar -->
    <record id="rm_hr" model="role.management">
        <field name="name">HR — faqat o'z ilovalari</field>
        <field name="role_ids" eval="[Command.set([ref('role_hr')])]"/>
        <field name="cst_shown_menu_ids" eval="[Command.set([
            ref('hr.menu_hr_root'),
            ref('hr_attendance.menu_hr_attendance_root'),
            ref('cst_kerama_payroll.menu_payroll_root'),
            ref('cst_kerama_reports.menu_reports_payroll'),
            ref('moizvonki_calls.menu_moizvonki_root'),
        ])]"/>
    </record>

    <!-- Bosh omborchi: Xarid, Xisobotlar (3-shaxslar, Ta'minotchilar,
         Yoqilg'i, Ombor), Inventarizatsiya (+ Jo'natish) -->
    <record id="rm_chief_warehouse" model="role.management">
        <field name="name">Bosh omborchi — faqat o'z ilovalari</field>
        <field name="role_ids" eval="[Command.set([ref('role_chief_warehouse')])]"/>
        <field name="cst_shown_menu_ids" eval="[Command.set([
            ref('purchase.menu_purchase_root'),
            ref('cst_kerama_reports.menu_reports_third_parties'),
            ref('cst_kerama_reports.menu_reports_suppliers'),
            ref('cst_kerama_reports.menu_reports_fuel'),
            ref('cst_kerama_reports.menu_reports_stock'),
            ref('stock.menu_stock_root'),
        ])]"/>
    </record>

    <!-- Ishlab chiqarish menejeri: Smena boshqaruvi, Xisobotlar (Ombor,
         Ishlab chiqarish), Inventarizatsiya, Ishlab chiqarish (+ Jo'natish) -->
    <record id="rm_production" model="role.management">
        <field name="name">Ishlab chiqarish — faqat o'z ilovalari</field>
        <field name="role_ids" eval="[Command.set([ref('role_production_manager')])]"/>
        <field name="cst_shown_menu_ids" eval="[Command.set([
            ref('cst_kerama_shift.menu_shift_root'),
            ref('cst_kerama_reports.menu_reports_stock'),
            ref('cst_kerama_reports.menu_reports_mrp'),
            ref('stock.menu_stock_root'),
            ref('mrp.menu_mrp_root'),
        ])]"/>
    </record>

    <!-- Omborchi: Inventarizatsiya, Xisobotlar (Ombor), Shtrix-kod
         (+ Jo'natish) -->
    <record id="rm_warehouse" model="role.management">
        <field name="name">Omborchi — faqat o'z ilovalari</field>
        <field name="role_ids" eval="[Command.set([ref('role_warehouse')])]"/>
        <field name="cst_shown_menu_ids" eval="[Command.set([
            ref('stock.menu_stock_root'),
            ref('cst_kerama_reports.menu_reports_stock'),
            ref('stock_barcode.stock_barcode_menu'),
        ])]"/>
    </record>

    <!-- Buxgalter: Buxgalteriya, Xisobotlar (3-shaxslar, Ta'minotchilar,
         Mijozlar), Xarajatlar -->
    <record id="rm_accountant" model="role.management">
        <field name="name">Buxgalter — faqat o'z ilovalari</field>
        <field name="role_ids" eval="[Command.set([ref('role_accountant')])]"/>
        <field name="cst_shown_menu_ids" eval="[Command.set([
            ref('accountant.menu_accounting'),
            ref('cst_kerama_reports.menu_reports_third_parties'),
            ref('cst_kerama_reports.menu_reports_suppliers'),
            ref('cst_kerama_reports.menu_reports_customers'),
            ref('hr_expense.menu_hr_expense_root'),
        ])]"/>
    </record>

    <!-- Kassir: Kassa, Buxgalteriya, Xisobotlar (Kassa), Xarajatlar -->
    <record id="rm_cashier" model="role.management">
        <field name="name">Kassir — faqat o'z ilovalari</field>
        <field name="role_ids" eval="[Command.set([ref('role_cashier')])]"/>
        <field name="cst_shown_menu_ids" eval="[Command.set([
            ref('cst_kerama_kassa.menu_kassa_root'),
            ref('accountant.menu_accounting'),
            ref('cst_kerama_reports.menu_reports_cash'),
            ref('hr_expense.menu_hr_expense_root'),
        ])]"/>
    </record>

    <!-- The app links a role back to its Role Management record from create(),
         which does not run on a module upgrade. Setting the pointer here keeps
         the two sides tied together whether the module is installed or updated
         — the menu filter reads it from the role, not from the manager. -->
    <record id="role_director" model="access.role">
        <field name="role_management_id" ref="rm_director"/>
    </record>
    <record id="role_sales_head" model="access.role">
        <field name="role_management_id" ref="rm_sales_head"/>
    </record>
    <record id="role_salesperson" model="access.role">
        <field name="role_management_id" ref="rm_salesperson"/>
    </record>
    <record id="role_controller" model="access.role">
        <field name="role_management_id" ref="rm_controller"/>
    </record>
    <record id="role_hr" model="access.role">
        <field name="role_management_id" ref="rm_hr"/>
    </record>
    <record id="role_chief_warehouse" model="access.role">
        <field name="role_management_id" ref="rm_chief_warehouse"/>
    </record>
    <record id="role_production_manager" model="access.role">
        <field name="role_management_id" ref="rm_production"/>
    </record>
    <record id="role_warehouse" model="access.role">
        <field name="role_management_id" ref="rm_warehouse"/>
    </record>
    <record id="role_accountant" model="access.role">
        <field name="role_management_id" ref="rm_accountant"/>
    </record>
    <record id="role_cashier" model="access.role">
        <field name="role_management_id" ref="rm_cashier"/>
    </record>

</odoo>
