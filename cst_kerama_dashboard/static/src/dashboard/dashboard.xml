<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="cst_kerama_dashboard.ChartRenderer">
        <div class="o_kerama_chart" t-att-style="style">
            <canvas t-ref="canvas"/>
        </div>
    </t>

    <t t-name="cst_kerama_dashboard.KpiCard">
        <div class="o_kerama_kpi card h-100"
             t-att-class="{ o_clickable: props.onClick }"
             t-on-click="() => props.onClick &amp;&amp; props.onClick()">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="o_kpi_icon flex-shrink-0"
                     t-att-style="'background:' + (props.color || '#714B67') + '22; color:' + (props.color || '#714B67')">
                    <i t-att-class="'fa ' + (props.icon || 'fa-circle')"/>
                </div>
                <div class="flex-grow-1 o_min_w0">
                    <div class="o_kpi_title text-uppercase fw-semibold mb-1">
                        <t t-esc="props.title"/>
                    </div>
                    <t t-if="props.values">
                        <div t-foreach="lines" t-as="line" t-key="line[0]"
                             class="o_kpi_value fw-bold text-truncate">
                            <t t-esc="format(line[1], line[0])"/>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="o_kpi_value o_kpi_value_lg fw-bold">
                            <t t-esc="format(props.value)"/>
                            <span t-if="props.suffix" class="o_kpi_suffix"> <t t-esc="props.suffix"/></span>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

    <t t-name="cst_kerama_dashboard.FilterBar">
        <div class="o_kerama_filterbar card">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-auto" t-if="has('date')">
                        <label class="o_filter_label">From</label>
                        <input type="date" class="form-control form-control-sm"
                               t-att-value="props.filters.date_from"
                               t-on-change="(ev) => this.onInput(ev, 'date_from')"/>
                    </div>
                    <div class="col-auto" t-if="has('date')">
                        <label class="o_filter_label">To</label>
                        <input type="date" class="form-control form-control-sm"
                               t-att-value="props.filters.date_to"
                               t-on-change="(ev) => this.onInput(ev, 'date_to')"/>
                    </div>
                    <div class="col-auto" t-if="has('so')">
                        <label class="o_filter_label">SO #</label>
                        <input type="text" placeholder="S00012" class="form-control form-control-sm"
                               t-att-value="props.filters.so_search"
                               t-on-change="(ev) => this.onInput(ev, 'so_search')"/>
                    </div>
                    <div class="col-auto" t-if="has('so_select')">
                        <label class="o_filter_label">Debt order</label>
                        <select class="form-select form-select-sm o_so_select" t-on-change="(ev) => this.onSaleOrder(ev)">
                            <option value="">All debt orders</option>
                            <t t-foreach="props.options.debt_orders or []" t-as="so" t-key="so.id">
                                <option t-att-value="so.id"
                                        t-att-selected="props.filters.so_id === so.id">
                                    <t t-esc="so.label"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="col-auto" t-if="has('journal')">
                        <label class="o_filter_label">Journal</label>
                        <select class="form-select form-select-sm" t-on-change="(ev) => this.onJournal(ev)">
                            <option value="">All</option>
                            <t t-foreach="props.options.journals" t-as="jr" t-key="jr.id">
                                <option t-att-value="jr.id"
                                        t-att-selected="props.filters.journal_id === jr.id">
                                    <t t-esc="jr.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="col-auto" t-if="has('warehouse')">
                        <label class="o_filter_label">Warehouse</label>
                        <select class="form-select form-select-sm" t-on-change="(ev) => this.onWarehouse(ev)">
                            <option value="">All warehouses</option>
                            <t t-foreach="props.options.warehouses or []" t-as="wh" t-key="wh.id">
                                <option t-att-value="wh.id"
                                        t-att-selected="props.filters.warehouse_id === wh.id">
                                    <t t-esc="wh.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="col-auto" t-if="has('salesperson')">
                        <label class="o_filter_label">Salesperson</label>
                        <select class="form-select form-select-sm" t-on-change="(ev) => this.onSalesperson(ev)">
                            <option value="">All</option>
                            <t t-foreach="props.options.salespersons" t-as="sp" t-key="sp.id">
                                <option t-att-value="sp.id"
                                        t-att-selected="props.filters.salesperson_id === sp.id">
                                    <t t-esc="sp.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="col-auto" t-if="has('client')">
                        <label class="o_filter_label">Client</label>
                        <input type="text" placeholder="name…" class="form-control form-control-sm"
                               t-att-value="props.filters.partner_search"
                               t-on-change="(ev) => this.onInput(ev, 'partner_search')"/>
                    </div>
                    <div class="col-auto" t-if="has('product')">
                        <label class="o_filter_label">Product</label>
                        <input type="text" placeholder="name / code…" class="form-control form-control-sm"
                               t-att-value="props.filters.product_search"
                               t-on-change="(ev) => this.onInput(ev, 'product_search')"/>
                    </div>
                    <div class="col-auto" t-if="has('currency')">
                        <label class="o_filter_label">Currency</label>
                        <select class="form-select form-select-sm"
                                t-on-change="(ev) => this.onInput(ev, 'currency')">
                            <option value="all" t-att-selected="props.filters.currency === 'all'">All</option>
                            <option value="UZS" t-att-selected="props.filters.currency === 'UZS'">UZS</option>
                            <option value="USD" t-att-selected="props.filters.currency === 'USD'">USD</option>
                        </select>
                    </div>
                    <div class="col-auto" t-if="has('company')">
                        <label class="o_filter_label d-block">Companies</label>
                        <t t-foreach="props.options.companies" t-as="co" t-key="co.id">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox"
                                       t-att-id="'kco' + co.id"
                                       t-att-checked="selectedCompanies.includes(co.id)"
                                       t-on-change="(ev) => this.toggleCompany(ev, co.id)"/>
                                <label class="form-check-label small" t-att-for="'kco' + co.id">
                                    <t t-esc="co.name"/>
                                </label>
                            </div>
                        </t>
                    </div>
                    <div class="col-auto ms-auto">
                        <button class="btn btn-sm btn-secondary" t-on-click="() => props.onReset()">
                            <i class="fa fa-refresh me-1"/>Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="cst_kerama_dashboard.Dashboard">
        <div class="o_kerama_dashboard h-100 overflow-auto p-3">

            <FilterBar filters="state.filters" options="state.options" fields="filterFields"
                       onChange.bind="onFiltersChange" onReset.bind="onReset"/>

            <div class="o_kerama_body mt-3">
                <t t-if="state.loading">
                    <div class="text-center text-muted p-5">
                        <i class="fa fa-spin fa-circle-o-notch fa-2x"/>
                    </div>
                </t>
                <t t-elif="state.tab === 'sales' and state.data">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md">
                            <KpiCard title="t('Total Sales')" icon="'fa-shopping-cart'"
                                     color="'#714B67'" values="state.data.kpis.total_sales"/>
                        </div>
                        <div class="col-6 col-md">
                            <KpiCard title="t('Orders')" icon="'fa-list-ol'"
                                     color="'#5bc0de'" value="state.data.kpis.order_count"/>
                        </div>
                        <div class="col-6 col-md">
                            <KpiCard title="t('Debt Due')" icon="'fa-exclamation-triangle'"
                                     color="'#d9534f'" values="state.data.kpis.total_debt"/>
                        </div>
                        <div class="col-6 col-md">
                            <KpiCard title="t('Cash In')" icon="'fa-money'"
                                     color="'#5cb85c'" values="state.data.kpis.cash_in"/>
                        </div>
                        <div class="col-6 col-md">
                            <KpiCard title="t('m² Sold')" icon="'fa-th-large'"
                                     color="'#f0ad4e'" value="state.data.kpis.m2_sold" suffix="'m²'"/>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-8">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Sales over time</h6>
                                    <ChartRenderer t-if="salesOverTimeConfig"
                                                   config="salesOverTimeConfig" height="320"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Top customers</h6>
                                    <ChartRenderer t-if="topCustomersConfig"
                                                   config="topCustomersConfig" height="320"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">By salesperson</h6>
                                    <ChartRenderer t-if="bySalespersonConfig" config="bySalespersonConfig"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Sales by currency</h6>
                                    <ChartRenderer t-if="byCurrencyConfig" config="byCurrencyConfig"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Order status funnel</h6>
                                    <ChartRenderer t-if="statusFunnelConfig" config="statusFunnelConfig"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Top products (by value)</h6>
                                    <ChartRenderer t-if="topProductsConfig"
                                                   config="topProductsConfig" height="300"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Sales by company</h6>
                                    <ChartRenderer t-if="salesByCompanyConfig"
                                                   config="salesByCompanyConfig" height="300"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-elif="state.tab === 'accounting' and state.data">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-4 col-xl-2">
                            <KpiCard title="t('Invoices')" icon="'fa-file-text-o'"
                                     color="'#5bc0de'" value="state.data.kpis.inv_count"/>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <KpiCard title="t('Sales (Invoiced)')" icon="'fa-shopping-cart'"
                                     color="'#714B67'" values="state.data.kpis.inv_amount"/>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <KpiCard title="t('Purchases')" icon="'fa-truck'"
                                     color="'#f0ad4e'" values="state.data.kpis.bill_amount"/>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <KpiCard title="t('Expenses')" icon="'fa-credit-card'"
                                     color="'#d9534f'" values="state.data.kpis.expenses"/>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <KpiCard title="t('Net Cash Flow')" icon="'fa-exchange'"
                                     color="'#5cb85c'" values="state.data.kpis.net_cashflow"/>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <KpiCard title="t('Net Profit')" icon="'fa-line-chart'"
                                     color="'#017e84'" values="state.data.kpis.pl_net"/>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-8">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Sales · Purchases · Expenses over time
                                        <small class="text-muted text-lowercase fw-normal"> (company currency)</small>
                                    </h6>
                                    <ChartRenderer t-if="flowOverTimeConfig"
                                                   config="flowOverTimeConfig" height="320"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Payments by journal</h6>
                                    <ChartRenderer t-if="paymentsByJournalConfig"
                                                   config="paymentsByJournalConfig" height="320"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Profit &amp; Loss</h6>
                                    <ChartRenderer t-if="profitAndLossConfig" config="profitAndLossConfig"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Cash in vs out</h6>
                                    <ChartRenderer t-if="cashInOutConfig" config="cashInOutConfig"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Top expense accounts</h6>
                                    <ChartRenderer t-if="topExpensesConfig" config="topExpensesConfig"/>
                                    <div t-else="" class="o_kerama_empty">No data</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-elif="state.tab === 'debts' and state.data">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <KpiCard title="t('Debt Orders')" icon="'fa-file-text-o'"
                                     color="'#d9534f'" value="state.data.kpis.debt_count"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <KpiCard title="t('Total Debt')" icon="'fa-exclamation-triangle'"
                                     color="'#d9534f'" values="state.data.kpis.debt_amount"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <KpiCard title="t('Debtor Clients')" icon="'fa-users'"
                                     color="'#f0ad4e'" value="state.data.kpis.client_count"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <KpiCard title="t('Avg Debt / Order')" icon="'fa-balance-scale'"
                                     color="'#714B67'" values="state.data.kpis.avg_debt"/>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-8">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Top debtors
                                        <small class="text-muted text-lowercase fw-normal"> (company currency)</small>
                                    </h6>
                                    <ChartRenderer t-if="topDebtorsConfig"
                                                   config="topDebtorsConfig" height="300"/>
                                    <div t-else="" class="o_kerama_empty">No debt</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Debt by currency
                                        <small class="text-muted text-lowercase fw-normal"> (in UZS)</small>
                                    </h6>
                                    <ChartRenderer t-if="debtByCurrencyConfig" config="debtByCurrencyConfig" height="300"/>
                                    <div t-else="" class="o_kerama_empty">No debt</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Debt aging (by order date)</h6>
                                    <ChartRenderer t-if="agingConfig" config="agingConfig"/>
                                    <div t-else="" class="o_kerama_empty">No debt</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Debt over time</h6>
                                    <ChartRenderer t-if="debtOverTimeConfig" config="debtOverTimeConfig"/>
                                    <div t-else="" class="o_kerama_empty">No debt</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Debtor orders</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>SO #</th>
                                                    <th>Client</th>
                                                    <th>Order date</th>
                                                    <th class="text-end">Amount due</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="state.data.table" t-as="row" t-key="row.so">
                                                    <td class="fw-semibold"><t t-esc="row.so"/></td>
                                                    <td><t t-esc="row.client"/></td>
                                                    <td><t t-esc="row.date"/></td>
                                                    <td class="text-end text-danger fw-semibold">
                                                        <t t-esc="formatMoney(row.due, row.currency)"/>
                                                    </td>
                                                </tr>
                                                <tr t-if="!state.data.table.length">
                                                    <td colspan="4" class="text-center text-muted py-3">No debtor orders</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-elif="state.tab === 'inventory' and state.data">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md">
                            <KpiCard title="t('Stock Valuation')" icon="'fa-database'"
                                     color="'#714B67'" values="state.data.kpis.stock_value"/>
                        </div>
                        <div class="col-6 col-md">
                            <KpiCard title="t('Products in Stock')" icon="'fa-cubes'"
                                     color="'#5bc0de'" value="state.data.kpis.products_in_stock"/>
                        </div>
                        <div class="col-6 col-md">
                            <KpiCard title="t('Units on Hand')" icon="'fa-th'"
                                     color="'#017e84'" value="state.data.kpis.units_on_hand"/>
                        </div>
                        <div class="col-6 col-md">
                            <KpiCard title="t('m² on Hand')" icon="'fa-th-large'"
                                     color="'#f0ad4e'" value="state.data.kpis.m2_on_hand" suffix="'m²'"/>
                        </div>
                        <div class="col-6 col-md">
                            <KpiCard title="t('Low / Out of Stock')" icon="'fa-exclamation-triangle'"
                                     color="'#d9534f'" value="state.data.kpis.low_stock_count"/>
                        </div>
                    </div>

                    <h6 class="o_kerama_card_title mb-2">Operations</h6>
                    <div class="row g-3 mb-3">
                        <div t-foreach="inventoryOps" t-as="op" t-key="op.id" class="col-6 col-md-4 col-xl-3">
                            <div class="card h-100 o_kerama_op">
                                <div class="card-body">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="o_kpi_icon flex-shrink-0"
                                             t-att-style="'background:' + opColor(op.code) + '22; color:' + opColor(op.code)">
                                            <i t-att-class="'fa ' + opIcon(op.code)"/>
                                        </div>
                                        <div class="o_min_w0">
                                            <div class="fw-semibold text-truncate"><t t-esc="op.name"/></div>
                                            <div class="small text-muted text-truncate"><t t-esc="op.company"/></div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between text-center">
                                        <div>
                                            <div class="fs-4 fw-bold"><t t-esc="op.todo"/></div>
                                            <div class="small text-muted">To process</div>
                                        </div>
                                        <div>
                                            <div class="fs-4 fw-bold text-danger"><t t-esc="op.late"/></div>
                                            <div class="small text-muted">Late</div>
                                        </div>
                                        <div>
                                            <div class="fs-4 fw-bold text-success"><t t-esc="op.done"/></div>
                                            <div class="small text-muted">Done</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div t-if="!inventoryOps.length" class="col-12">
                            <div class="o_kerama_empty">No operations</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-8">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Stock moves over time
                                        <small class="text-muted text-lowercase fw-normal"> (units in vs out)</small>
                                    </h6>
                                    <ChartRenderer t-if="movesOverTimeConfig" config="movesOverTimeConfig" height="300"/>
                                    <div t-else="" class="o_kerama_empty">No moves</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">m² in stock by category</h6>
                                    <ChartRenderer t-if="m2ByCategoryConfig" config="m2ByCategoryConfig" height="300"/>
                                    <div t-else="" class="o_kerama_empty">No m² stock</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Stock by warehouse
                                        <small class="text-muted text-lowercase fw-normal"> (units)</small>
                                    </h6>
                                    <ChartRenderer t-if="stockByWarehouseConfig" config="stockByWarehouseConfig"/>
                                    <div t-else="" class="o_kerama_empty">No stock</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Top products on hand (qty)</h6>
                                    <ChartRenderer t-if="topProductsQtyConfig" config="topProductsQtyConfig"/>
                                    <div t-else="" class="o_kerama_empty">No stock</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h6 class="o_kerama_card_title">Low / out-of-stock products</h6>
                                    <div class="table-responsive o_kerama_lowstock">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Product</th>
                                                    <th class="text-end">On hand</th>
                                                    <th class="text-end">Min</th>
                                                    <th class="text-center">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="state.data.low_stock" t-as="row" t-key="row.product">
                                                    <td class="text-truncate"><t t-esc="row.product"/></td>
                                                    <td class="text-end"><t t-esc="row.on_hand"/></td>
                                                    <td class="text-end text-muted"><t t-esc="row.min"/></td>
                                                    <td class="text-center">
                                                        <span t-att-class="row.status === 'out' ? 'badge text-bg-danger' : 'badge text-bg-warning'">
                                                            <t t-esc="row.status === 'out' ? 'Out' : 'Low'"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                                <tr t-if="!state.data.low_stock.length">
                                                    <td colspan="4" class="text-center text-muted py-3">All good — nothing low</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-elif="state.tab === 'stock' and state.data">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <KpiCard title="t('Products in Stock')" icon="'fa-cubes'"
                                     color="'#5bc0de'" value="state.data.kpis.product_count"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <KpiCard title="t('Stock Valuation')" icon="'fa-database'"
                                     color="'#714B67'" values="state.data.kpis.stock_value"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <KpiCard title="t('Units on Hand')" icon="'fa-th'"
                                     color="'#017e84'" value="state.data.kpis.units_on_hand"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <KpiCard title="t('m² on Hand')" icon="'fa-th-large'"
                                     color="'#f0ad4e'" value="state.data.kpis.m2_on_hand" suffix="'m²'"/>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="card o_kerama_stockcard">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold">Stock on hand by product</span>
                                    <span class="badge text-bg-light text-muted fw-normal">
                                        <t t-if="state.data.total > state.data.shown">
                                            Top <t t-esc="state.data.shown"/> of <t t-esc="state.data.total"/> by value
                                        </t>
                                        <t t-else="">
                                            <t t-esc="state.data.total"/> product(s)
                                        </t>
                                    </span>
                                </div>
                                <div class="table-responsive o_kerama_stocktable">
                                    <table class="table table-sm table-striped table-hover align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th class="o_col_product">Product</th>
                                                <th class="o_col_categ">Category</th>
                                                <th class="text-end o_col_num">On hand</th>
                                                <th class="text-end o_col_num">Reserved</th>
                                                <th class="text-end o_col_num">Available</th>
                                                <th class="o_col_uom">UoM</th>
                                                <th class="text-end o_col_val">Value</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.data.rows" t-as="row" t-key="row.id">
                                                <td class="o_col_product">
                                                    <span class="fw-semibold d-block text-truncate"><t t-esc="row.product"/></span>
                                                    <small t-if="row.code" class="text-muted font-monospace"><t t-esc="row.code"/></small>
                                                </td>
                                                <td class="text-muted text-truncate o_col_categ"><t t-esc="row.category"/></td>
                                                <td class="text-end fw-semibold o_col_num"><t t-esc="formatMoney(row.on_hand)"/></td>
                                                <td class="text-end o_col_num" t-att-class="row.reserved ? 'text-warning' : 'text-muted'">
                                                    <t t-esc="formatMoney(row.reserved)"/>
                                                </td>
                                                <td class="text-end o_col_num" t-att-class="row.available > 0 ? 'text-success' : 'text-danger'">
                                                    <t t-esc="formatMoney(row.available)"/>
                                                </td>
                                                <td class="text-muted o_col_uom"><t t-esc="row.uom"/></td>
                                                <td class="text-end fw-semibold o_col_val"><t t-esc="formatMoney(row.value, state.data.company_currency)"/></td>
                                            </tr>
                                            <tr t-if="!state.data.rows.length">
                                                <td colspan="7" class="text-center text-muted py-4">
                                                    <i class="fa fa-inbox fa-2x d-block mb-2 opacity-50"/>
                                                    No products in stock for this selection
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center text-muted p-5">
                        <i class="fa fa-wrench fa-3x mb-3 d-block"/>
                        <h5><t t-esc="tabLabel"/> dashboard — coming next</h5>
                        <p>The scaffold, filter bar and shared components are ready;
                           this tab is built in the next phase.</p>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
