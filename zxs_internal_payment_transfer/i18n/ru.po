#. module: zxs_internal_payment_transfer
#: model_terms:ir.ui.view,arch_db:zxs_internal_payment_transfer.view_account_payment_form_internal_transfer
msgid "<span class=\"o_stat_text\">Paired Transfer</span>"
msgstr "<span class=\"o_stat_text\">Парный перевод</span>"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "A paired internal transfer payment was created: %(link)s"
msgstr "Создан парный платёж внутреннего перевода: %(link)s"

#. module: zxs_internal_payment_transfer
#: model:ir.model.fields,field_description:zxs_internal_payment_transfer.field_account_payment__destination_amount
msgid "Amount Received"
msgstr "Полученная сумма"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid ""
"Configure an Internal Transfer account under Accounting -> Configuration -> "
"Settings."
msgstr ""
"Укажите счёт внутренних переводов в разделе Бухгалтерия -> Настройки -> "
"Настройки."

#. module: zxs_internal_payment_transfer
#: model:ir.model.fields,field_description:zxs_internal_payment_transfer.field_account_payment__destination_currency_id
msgid "Destination Currency"
msgstr "Валюта получателя"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
#: model:ir.model.fields,field_description:zxs_internal_payment_transfer.field_account_payment__destination_journal_id
msgid "Destination Journal"
msgstr "Журнал получателя"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "Destination journal is required for internal transfers."
msgstr "Для внутренних переводов обязателен журнал получателя."

#. module: zxs_internal_payment_transfer
#: model:ir.model.fields,field_description:zxs_internal_payment_transfer.field_account_journal__display_name
#: model:ir.model.fields,field_description:zxs_internal_payment_transfer.field_account_payment__display_name
msgid "Display Name"
msgstr "Отображаемое имя"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "Exchange difference on %s"
msgstr "Курсовая разница по %s"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "Gain"
msgstr "Доход"

#. module: zxs_internal_payment_transfer
#: model:ir.model.fields,field_description:zxs_internal_payment_transfer.field_account_journal__id
#: model:ir.model.fields,field_description:zxs_internal_payment_transfer.field_account_payment__id
msgid "ID"
msgstr "ID"

#. module: zxs_internal_payment_transfer
#: model:ir.model.fields,field_description:zxs_internal_payment_transfer.field_account_payment__is_internal_transfer
#: model_terms:ir.ui.view,arch_db:zxs_internal_payment_transfer.account_journal_dashboard_kanban_view_internal_transfer
msgid "Internal Transfer"
msgstr "Внутренний перевод"

#. module: zxs_internal_payment_transfer
#: model:ir.ui.menu,name:zxs_internal_payment_transfer.menu_action_account_payments_transfer
#: model_terms:ir.ui.view,arch_db:zxs_internal_payment_transfer.view_account_payment_search_internal_transfer
msgid "Internal Transfers"
msgstr "Внутренние переводы"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "Internal transfer amount must be greater than zero."
msgstr "Сумма внутреннего перевода должна быть больше нуля."

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid ""
"Internal transfers must be confirmed as Send payments. The matching Receive "
"payment is created automatically on %(journal)s."
msgstr ""
"Внутренние переводы подтверждаются как исходящие платежи. Соответствующий "
"входящий платёж создаётся автоматически в журнале %(journal)s."

#. module: zxs_internal_payment_transfer
#: model:ir.model,name:zxs_internal_payment_transfer.model_account_journal
msgid "Journal"
msgstr "Журнал"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "Loss"
msgstr "Убыток"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid ""
"No %(payment_type)s payment method is configured on journal %(journal)s. "
"Configure Outstanding Payments/Receipts on the journal payment methods."
msgstr ""
"В журнале %(journal)s не настроен способ оплаты %(payment_type)s. Укажите "
"счёт транзитных платежей/поступлений в способах оплаты журнала."

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid ""
"No Exchange %(kind)s account is configured, so the %(amount)s this transfer "
"differs by cannot be booked. Set it under Accounting -> Configuration -> "
"Settings."
msgstr ""
"Не настроен счёт курсовой разницы (%(kind)s), поэтому разницу %(amount)s по "
"этому переводу нельзя провести. Укажите его в разделе Бухгалтерия -> "
"Настройки -> Настройки."

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "Paired Internal Transfer"
msgstr "Парный внутренний перевод"

#. module: zxs_internal_payment_transfer
#: model:ir.model,name:zxs_internal_payment_transfer.model_account_payment
msgid "Payments"
msgstr "Платежи"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "Source and destination journals must be different."
msgstr "Журналы отправителя и получателя должны различаться."

#. module: zxs_internal_payment_transfer
#: model:ir.model.fields,help:zxs_internal_payment_transfer.field_account_payment__destination_currency_id
msgid ""
"The currency the destination journal is held in.  A journal tied to one "
"currency can only receive that currency."
msgstr ""
"Валюта, в которой ведётся журнал получателя. Журнал, привязанный к одной "
"валюте, может принимать только эту валюту."

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "This payment was created from: %(link)s"
msgstr "Этот платёж создан из: %(link)s"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid ""
"This transfer converts %(source)s into %(destination)s, and the two sides "
"differ by %(amount)s. Set an Exchange Gain or Loss Journal under Accounting "
"-> Configuration -> Settings so the difference can be booked."
msgstr ""
"Этот перевод конвертирует %(source)s в %(destination)s, и стороны "
"различаются на %(amount)s. Укажите журнал курсовых разниц в разделе "
"Бухгалтерия -> Настройки -> Настройки, чтобы провести разницу."

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "Transfer from %s"
msgstr "Перевод из %s"

#. module: zxs_internal_payment_transfer
#. odoo-python
#: code:addons/zxs_internal_payment_transfer/models/account_payment.py:0
msgid "Transfer to %s"
msgstr "Перевод в %s"

#. module: zxs_internal_payment_transfer
#: model:ir.model.fields,help:zxs_internal_payment_transfer.field_account_payment__destination_amount
msgid ""
"What lands in the destination journal.  Filled in at the rate of the payment"
" date; type over it to use the rate you actually got."
msgstr ""
"Сумма, поступающая в журнал получателя. Заполняется по курсу на дату "
"платежа; введите свою сумму, чтобы применить фактически полученный курс."
