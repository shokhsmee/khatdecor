<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_search_internal_transfer" model="ir.ui.view">
        <field name="name">account.payment.search.internal.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inbound_filter']" position="after">
                <filter string="Internal Transfers"
                        name="transfers_filter"
                        domain="[('is_internal_transfer', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_internal_transfer" model="ir.ui.view">
        <field name="name">account.payment.form.internal.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_paired_payment"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="not paired_internal_transfer_payment_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Paired Transfer</span>
                    </div>
                </button>
<!--                <button name="action_open_destination_journal"-->
<!--                        type="object"-->
<!--                        class="oe_stat_button"-->
<!--                        icon="fa-book"-->
<!--                        invisible="not is_internal_transfer or not destination_journal_id">-->
<!--                    <div class="o_stat_info">-->
<!--                        <span class="o_stat_text">Destination Journal</span>-->
<!--                    </div>-->
<!--                </button>-->
            </xpath>

            <xpath expr="//field[@name='payment_type']" position="before">
                <field name="is_internal_transfer"
                       readonly="state != 'draft' or paired_internal_transfer_payment_id"/>
            </xpath>

            <xpath expr="//group[@name='group1']/field[@name='partner_id'][1]" position="attributes">
                <attribute name="invisible">partner_type != 'customer' or is_internal_transfer</attribute>
            </xpath>
            <xpath expr="//group[@name='group1']/field[@name='partner_id'][2]" position="attributes">
                <attribute name="invisible">partner_type != 'supplier' or is_internal_transfer</attribute>
            </xpath>

            <xpath expr="//div[@name='amount_div']" position="after">
                <label for="destination_amount"
                       invisible="not is_internal_transfer or destination_currency_id == currency_id"/>
                <div name="destination_amount_div" class="o_row"
                     invisible="not is_internal_transfer or destination_currency_id == currency_id">
                    <field name="destination_amount"
                           readonly="state != 'draft' or paired_internal_transfer_payment_id"/>
                    <field name="destination_currency_id" readonly="1"
                           options="{'no_create': True, 'no_open': True}"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="destination_journal_id"
                       invisible="not is_internal_transfer"
                       required="is_internal_transfer"
                       readonly="state != 'draft' or paired_internal_transfer_payment_id"
                       options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//group[@name='group2']/field[@name='partner_bank_id'][1]" position="attributes">
                <attribute name="invisible">not show_partner_bank_account or partner_type != 'customer' or payment_type == 'inbound' or is_internal_transfer</attribute>
            </xpath>
            <xpath expr="//group[@name='group2']/field[@name='partner_bank_id'][2]" position="attributes">
                <attribute name="invisible">not show_partner_bank_account or partner_type != 'supplier' or payment_type == 'inbound' or is_internal_transfer</attribute>
            </xpath>
            <xpath expr="//group[@name='group2']/field[@name='partner_bank_id'][3]" position="attributes">
                <attribute name="invisible">not show_partner_bank_account or payment_type == 'outbound' or is_internal_transfer</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="readonly">state != 'draft' or is_internal_transfer</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_internal_transfer" model="ir.ui.view">
        <field name="name">account.payment.list.internal.transfer</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_internal_transfer" optional="hide"/>
                <field name="destination_journal_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="account.action_account_payments_transfer" model="ir.actions.act_window">
        <field name="context">{
            'default_payment_type': 'outbound',
            'default_is_internal_transfer': True,
            'search_default_transfers_filter': 1,
            'display_account_trust': True,
        }</field>
        <field name="domain">[('is_internal_transfer', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an internal transfer
            </p>
            <p>
                Move funds between your bank and cash journals. Confirming a Send transfer
                automatically creates the matching Receive payment on the destination journal.
            </p>
        </field>
    </record>
</odoo>
