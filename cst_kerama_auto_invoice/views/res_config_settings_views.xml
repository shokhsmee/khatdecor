<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_auto_invoice" model="ir.ui.view">
        <field name="name">res.config.settings.form.auto.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="cst_kerama_kassa.res_config_settings_view_form_kassa"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='kassa_tags']" position="after">
                <block title="Avtomatik hisob-faktura" name="auto_invoice">
                    <setting string="Sotuv"
                             help="Yuk chiqarilganda chiqqan tovarga hisob-faktura darhol yaratiladi va tasdiqlanadi. Kassadagi to'lov faqat mavjud hisob-fakturalarni yopadi; yetkazilmagan tovar puli avans bo'lib turadi va yuk chiqqanda o'zi yopiladi.">
                        <field name="cst_auto_invoice_sale"/>
                    </setting>
                    <setting string="Xarid"
                             help="Tovar qabul qilinganda qabul qilingan miqdorga ta'minotchi schyoti darhol yaratiladi va tasdiqlanadi. Kassadan ta'minotchiga to'lov uning ochiq schyotlarini (eskisidan) yopadi.">
                        <field name="cst_auto_invoice_purchase"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
