<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="cst_kerama_appsbar.AppsBar" t-inherit="muk_web_appsbar.AppsBar" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('mk_apps_sidebar_menu')]" position="before">
            <a t-if="toggleState.enabled"
               href="#"
               class="mk_apps_sidebar_toggle"
               role="button"
               t-att-title="toggleTitle"
               t-on-click.prevent="_onToggleClick">
                <i t-attf-class="fa {{ toggleState.collapsed ? 'fa-angle-double-right' : 'fa-angle-double-left' }}"/>
            </a>
        </xpath>
        <xpath expr="//ul[hasclass('mk_apps_sidebar_menu')]//a" position="attributes">
            <attribute name="t-att-title">app.label</attribute>
        </xpath>
    </t>

</templates>
