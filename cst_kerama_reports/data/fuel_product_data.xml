<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Fuel is an ordinary stocked product: it is received, it is issued,
             it has a balance and a cost. Nothing about the fuel report needs a
             parallel little world of its own — the only thing the product
             carries is the flag that puts it in the report's selector.

             noupdate: once accountants have set the category's accounts or
             renamed the product, an upgrade must not undo it. -->

        <record id="product_category_fuel" model="product.category">
            <field name="name">Yoqilg'i</field>
        </record>

        <record id="product_diesel" model="product.template">
            <field name="name">Salyarka (dizel yoqilg'isi)</field>
            <field name="default_code">SALYARKA</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="uom_id" ref="uom.product_uom_litre"/>
            <field name="categ_id" ref="product_category_fuel"/>
            <field name="cst_is_fuel" eval="True"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
            <field name="description">Yoqilg'i hisobotida ishlatiladi. Chiqim
                mashinaga quyilganda hisobdan chiqadi.</field>
        </record>

        <record id="product_petrol" model="product.template">
            <field name="name">Benzin</field>
            <field name="default_code">BENZIN</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="uom_id" ref="uom.product_uom_litre"/>
            <field name="categ_id" ref="product_category_fuel"/>
            <field name="cst_is_fuel" eval="True"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
        </record>

        <record id="product_gas" model="product.template">
            <field name="name">Gaz (metan)</field>
            <field name="default_code">GAZ</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="uom_id" ref="uom.product_uom_cubic_meter"/>
            <field name="categ_id" ref="product_category_fuel"/>
            <field name="cst_is_fuel" eval="True"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
        </record>

    </data>
</odoo>
