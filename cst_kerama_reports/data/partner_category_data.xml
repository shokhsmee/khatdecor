<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Utilities are ordinary suppliers billed through vendor bills; this
             tag is what the «Kommunal xizmatlar akt sverkasi» wizard filters on. -->
        <record id="partner_category_utilities" model="res.partner.category">
            <field name="name">Kommunal xizmatlar</field>
            <field name="color">4</field>
        </record>
        <!-- «3-shaxslar» harakati / akt sverkasi: a tagged contact is a third
             party whatever its customer / supplier ranks. -->
        <record id="partner_category_third_party" model="res.partner.category">
            <field name="name">3-shaxslar</field>
            <field name="color">9</field>
        </record>
    </data>
</odoo>
