<odoo>

    <!-- ==========================================================
         Xisobotlar — one app, one place, categories inside it.

         Almost every entry below points at an action Odoo already ships:
         the accounting reports of `account_reports`, the sales, purchase,
         inventory and manufacturing analyses, product margins, lots,
         reordering rules. Nothing is reimplemented, so each screen keeps its
         own filters, pivot, graph and export. The entries marked with a ★ in
         the manifest are the ones Odoo has no answer for.

         Groups sit on the individual items rather than only on the category:
         a menu the user can see but whose report refuses to open is worse
         than no menu at all.
         ========================================================== -->

    <menuitem id="menu_reports_root"
              name="Xisobotlar"
              web_icon="cst_kerama_reports,static/description/icon.png"
              sequence="36"/>

