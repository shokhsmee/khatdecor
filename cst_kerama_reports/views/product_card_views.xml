<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_card_wizard_form" model="ir.ui.view">
        <field name="name">cst.product.card.wizard.form</field>
        <field name="model">cst.product.card.wizard</field>
        <field name="arch" type="xml">
            <form string="Mahsulot kartochkasi">
                <group>
                    <group>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="daily"/>
                    </group>
                    <group>
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Hamma omborlar (bo'sh = hammasi)"/>
                        <field name="together"/>
                        <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                </group>
                <p class="text-muted">Mahsulotning har bir harakati sanama-sana: hujjat, qayerdan → qayerga, kirim, chiqim
                    va harakatdan keyingi qoldiq. Tepada — hozirgi qoldiq har ombor bo'yicha.</p>
                <footer>
                    <button name="action_view" type="object" string="Ekranda ko'rish" class="btn-primary"/>
                    <button name="action_xlsx" type="object" string="Excel" class="btn-secondary" icon="fa-file-excel-o"/>
                    <button name="action_print" type="object" string="PDF" class="btn-secondary"/>
                    <button string="Bekor qilish" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_product_card_report" model="ir.actions.act_window">
        <field name="name">Mahsulot kartochkasi</field>
        <field name="res_model">cst.product.card.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_reports_product_card"
              name="Mahsulot kartochkasi (sanama-sana)"
              parent="menu_reports_stock"
              action="action_product_card_report"
              sequence="6"/>

    <!-- the same card from the product itself and from «Ko'chirishlar tarixi» -->
    <record id="action_server_product_card_variant" model="ir.actions.server">
        <field name="name">Mahsulot kartochkasi (qoldiq bilan)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = env["cst.product.card.wizard"].action_from_products(records.ids)</field>
    </record>
    <record id="action_server_product_card_template" model="ir.actions.server">
        <field name="name">Mahsulot kartochkasi (qoldiq bilan)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = env["cst.product.card.wizard"].action_from_products(records.product_variant_ids.ids)</field>
    </record>
    <record id="action_server_product_card_move_line" model="ir.actions.server">
        <field name="name">Mahsulot kartochkasi (qoldiq bilan)</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="binding_model_id" ref="stock.model_stock_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env["cst.product.card.wizard"].action_from_products(records.product_id.ids)</field>
    </record>
</odoo>
