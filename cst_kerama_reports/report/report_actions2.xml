    <record id="action_report_employee_card" model="ir.actions.report">
        <field name="name">Xodim oyligi kartochkasi</field>
        <field name="model">cst.employee.card.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cst_kerama_reports.report_employee_card</field>
        <field name="report_file">cst_kerama_reports.report_employee_card</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="print_report_name">'Oylik %s' % (object.employee_id.display_name or '')</field>
    </record>
    <record id="action_report_employee_card_html" model="ir.actions.report">
        <field name="name">Xodim oyligi kartochkasi (ekranda)</field>
