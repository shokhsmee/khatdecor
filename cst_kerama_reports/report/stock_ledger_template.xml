<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- On screen the ledger is wide but readable; the Excel button on the
         wizard gives the workbook the storekeepers actually work in. -->
    <template id="report_stock_ledger">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="values" t-value="doc._report_values()"/>
                <t t-set="data" t-value="values['data']"/>
                <t t-set="engine" t-value="doc.env['cst.warehouse.report']"/>
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-call="cst_kerama_reports.report_style"/>
                        <style t-if="report_type != 'html'">.cst_rep.cst_ledger { font-size: 7.5px; } .cst_rep.cst_ledger th, .cst_rep.cst_ledger td { padding: 1px 2px; }</style>
                        <t t-call="cst_kerama_reports.report_header">
                            <t t-set="title" t-value="values['title']"/>
                            <t t-set="date_from" t-value="values['date_from']"/>
                            <t t-set="date_to" t-value="values['date_to']"/>
                        </t>
                        <t t-set="in_flows" t-value="data['in_flows']"/>
                        <t t-set="out_flows" t-value="data['out_flows']"/>
                        <table class="cst_rep cst_ledger">
                            <thead>
                                <tr>
                                    <th rowspan="2">№</th>
                                    <th rowspan="2">Nomi</th>
                                    <th rowspan="2">Xarakt.</th>
                                    <th rowspan="2">O'lch.</th>
                                    <th colspan="3"><span t-out="values['date_from']" t-options="{'widget': 'date'}"/> kun boshiga qoldiq</th>
                                    <t t-foreach="in_flows" t-as="f"><th colspan="2" t-out="f[1]"/></t>
                                    <th colspan="2">Qayta baholandi</th>
                                    <t t-foreach="out_flows" t-as="f"><th colspan="2" t-out="f[1]"/></t>
                                    <th colspan="3"><span t-out="values['date_to']" t-options="{'widget': 'date'}"/> kun oxiriga qoldiq</th>
                                </tr>
                                <tr>
                                    <th>Soni</th><th>Tannarxi</th><th>Summasi</th>
                                    <t t-foreach="in_flows" t-as="f"><th>Soni</th><th>Summasi</th></t>
                                    <th>Kirim</th><th>Chiqim</th>
                                    <t t-foreach="out_flows" t-as="f"><th>Soni</th><th>Summasi</th></t>
                                    <th>Soni</th><th>Tannarxi</th><th>Summasi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="width" t-value="4 + 3 + 2 * len(in_flows) + 2 + 2 * len(out_flows) + 3"/>
                                <t t-if="not data['warehouses']">
                                    <tr><td t-att-colspan="width" class="mid">Harakat topilmadi.</td></tr>
                                </t>
                                <t t-foreach="data['warehouses']" t-as="wh">
                                    <tr class="cst_company">
                                        <td colspan="4"><t t-out="wh['company'].name"/> — <t t-out="wh['warehouse'].name"/></td>
                                        <t t-call="cst_kerama_reports.ledger_cells"><t t-set="row" t-value="wh['totals']"/></t>
                                    </tr>
                                    <t t-foreach="wh['groups']" t-as="g">
                                        <tr class="cst_group">
                                            <td colspan="4" t-out="engine.category_label(g['category'])"/>
                                            <t t-call="cst_kerama_reports.ledger_cells"><t t-set="row" t-value="g['totals']"/></t>
                                        </tr>
                                        <t t-foreach="g['leaves']" t-as="c">
                                            <tr class="cst_sub" t-if="c['category'] != g['category']">
                                                <td colspan="4" t-out="c['category'].name"/>
                                                <t t-call="cst_kerama_reports.ledger_cells"><t t-set="row" t-value="c['totals']"/></t>
                                            </tr>
                                            <t t-foreach="c['products']" t-as="p">
                                                <tr>
                                                    <td class="mid" t-out="p_index + 1"/>
                                                    <td t-out="engine.product_label(p['product'])"/>
                                                    <td t-out="p['characteristic']"/>
                                                    <td class="mid" t-out="p['uom']"/>
                                                    <t t-call="cst_kerama_reports.ledger_cells"><t t-set="row" t-value="p"/></t>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                                <tr class="cst_total" t-if="data['warehouses']">
                                    <td colspan="4" class="mid">JAMI</td>
                                    <t t-call="cst_kerama_reports.ledger_cells"><t t-set="row" t-value="data['totals']"/></t>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- one row of figures; totals rows carry no unit cost -->
    <template id="ledger_cells">
        <td class="num"><span t-if="row['open_qty']" t-out="row['open_qty']" t-options="{'widget': 'float', 'precision': 3}"/></td>
        <td class="num"><span t-if="row.get('open_cost')" t-out="row['open_cost']" t-options="{'widget': 'float', 'precision': 2}"/></td>
        <td class="num"><span t-if="row['open_value']" t-out="row['open_value']" t-options="{'widget': 'float', 'precision': 2}"/></td>
        <t t-foreach="in_flows" t-as="f">
            <td class="num"><span t-if="row['flows'][f[0]][0]" t-out="row['flows'][f[0]][0]" t-options="{'widget': 'float', 'precision': 3}"/></td>
            <td class="num"><span t-if="row['flows'][f[0]][1]" t-out="row['flows'][f[0]][1]" t-options="{'widget': 'float', 'precision': 2}"/></td>
        </t>
        <td class="num"><span t-if="row['reval_in']" t-out="row['reval_in']" t-options="{'widget': 'float', 'precision': 2}"/></td>
        <td class="num"><span t-if="row['reval_out']" t-out="row['reval_out']" t-options="{'widget': 'float', 'precision': 2}"/></td>
        <t t-foreach="out_flows" t-as="f">
            <td class="num"><span t-if="row['flows'][f[0]][0]" t-out="row['flows'][f[0]][0]" t-options="{'widget': 'float', 'precision': 3}"/></td>
            <td class="num"><span t-if="row['flows'][f[0]][1]" t-out="row['flows'][f[0]][1]" t-options="{'widget': 'float', 'precision': 2}"/></td>
        </t>
        <td class="num"><span t-if="row['close_qty']" t-out="row['close_qty']" t-options="{'widget': 'float', 'precision': 3}"/></td>
        <td class="num"><span t-if="row.get('close_cost')" t-out="row['close_cost']" t-options="{'widget': 'float', 'precision': 2}"/></td>
        <td class="num"><span t-if="row['close_value']" t-out="row['close_value']" t-options="{'widget': 'float', 'precision': 2}"/></td>
    </template>

</odoo>
