<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A signed amount: negatives in red, zeros blank. -->
    <template id="cell_amount">
        <td class="num">
            <span t-if="value" t-out="value"
                  t-attf-class="{{ 'text-danger' if value &lt; 0 else '' }}"
                  t-options="{'widget': 'float', 'precision': 2}"/>
        </td>
    </template>

    <!-- ============ Xodim oyligi (individual) ============ -->
    <template id="report_employee_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="values" t-value="doc._report_values()"/>
                <t t-set="data" t-value="values['data']"/>
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-call="cst_kerama_reports.report_style"/>
                        <t t-call="cst_kerama_reports.report_header">
                            <t t-set="title" t-value="values['title']"/>
                            <t t-set="date_from" t-value="values['date_from']"/>
                            <t t-set="date_to" t-value="values['date_to']"/>
                        </t>
                        <table class="cst_rep">
                            <thead>
                                <tr>
                                    <th style="width:26px;">№</th>
                                    <th style="width:64px;">Sana</th>
                                    <th>Izoh</th>
                                    <th style="width:80px;">Boshlang'ich qoldiq</th>
                                    <th style="width:80px;">Hisoblandi</th>
                                    <th style="width:80px;">Ushlandi</th>
                                    <th style="width:80px;">Oxirgi qoldiq</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="cst_company">
                                    <td colspan="3" t-out="data['employee'].display_name"/>
                                    <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="data['opening']"/></t>
                                    <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="data['accrued']"/></t>
                                    <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="data['deducted']"/></t>
                                    <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="data['closing']"/></t>
                                </tr>
                                <t t-if="not data['rows']">
                                    <tr><td colspan="7" class="mid">Davr ichida yozuv yo'q.</td></tr>
                                </t>
                                <t t-foreach="data['rows']" t-as="row">
                                    <tr>
                                        <td class="mid" t-out="row_index + 1"/>
                                        <td class="mid" t-out="row['date']" t-options="{'widget': 'date'}"/>
                                        <td t-out="row['label']"/>
                                        <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="row['before']"/></t>
                                        <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="row['accrued']"/></t>
                                        <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="row['deducted']"/></t>
                                        <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="row['after']"/></t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============ Jarimalar va bonuslar ============ -->
    <template id="report_bonus_penalty">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="values" t-value="doc._report_values()"/>
                <t t-set="data" t-value="values['data']"/>
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-call="cst_kerama_reports.report_style"/>
                        <t t-call="cst_kerama_reports.report_header">
                            <t t-set="title" t-value="values['title']"/>
                            <t t-set="date_from" t-value="values['date_from']"/>
                            <t t-set="date_to" t-value="values['date_to']"/>
                        </t>
                        <table class="cst_rep">
                            <thead>
                                <tr>
                                    <th style="width:26px;">№</th>
                                    <th>Bonus yoki jarima mavzusi</th>
                                    <th style="width:140px;">Bonus yoki jarima turi</th>
                                    <th style="width:70px;">Sana</th>
                                    <th style="width:90px;">Summasi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="not data['employees']">
                                    <tr><td colspan="5" class="mid">Davr ichida bonus yoki jarima yo'q.</td></tr>
                                </t>
                                <t t-foreach="data['employees']" t-as="emp">
                                    <tr class="cst_sub">
                                        <td class="mid" t-out="emp_index + 1"/>
                                        <td colspan="3" class="mid" t-out="emp['employee'].display_name"/>
                                        <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="emp['total']"/></t>
                                    </tr>
                                    <t t-foreach="emp['lines']" t-as="row">
                                        <tr>
                                            <td class="mid" t-out="row_index + 1"/>
                                            <td t-out="row['topic']"/>
                                            <td t-out="row['type']"/>
                                            <td class="mid" t-out="row['date']" t-options="{'widget': 'date'}"/>
                                            <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="row['amount']"/></t>
                                        </tr>
                                    </t>
                                </t>
                                <tr class="cst_total">
                                    <td colspan="4" class="mid">Jami</td>
                                    <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="data['total']"/></t>
                                </tr>
                            </tbody>
                        </table>
                        <br/>
                        <table class="cst_rep" style="width:60%;">
                            <thead>
                                <tr>
                                    <th style="width:26px;">№</th>
                                    <th>Jarima va bonus turlari</th>
                                    <th style="width:90px;">Summasi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data['by_type']" t-as="row">
                                    <tr>
                                        <td class="mid" t-out="row_index + 1"/>
                                        <td t-out="row['component'].name"/>
                                        <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="row['amount']"/></t>
                                    </tr>
                                </t>
                                <tr class="cst_total">
                                    <td colspan="2" class="mid">Jami</td>
                                    <t t-call="cst_kerama_reports.cell_amount"><t t-set="value" t-value="data['total']"/></t>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============ KPI ============ -->
    <template id="report_kpi">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="values" t-value="doc._report_values()"/>
                <t t-set="data" t-value="values['data']"/>
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-call="cst_kerama_reports.report_style"/>
                        <t t-call="cst_kerama_reports.report_header">
                            <t t-set="title" t-value="values['title']"/>
                            <t t-set="date_from" t-value="values['date_from']"/>
                            <t t-set="date_to" t-value="values['date_to']"/>
                        </t>
                        <table class="cst_rep">
                            <thead>
                                <tr>
                                    <th style="width:26px;">№</th>
                                    <th>Menejer nomi</th>
                                    <th style="width:90px;">Xarakteristika</th>
                                    <th style="width:60px;">Soni</th>
                                    <th style="width:70px;">KPI narxi</th>
                                    <th style="width:100px;">KPI summasi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="not data['companies']">
                                    <tr><td colspan="6" class="mid">Davr ichida KPI yozuvlari yo'q.</td></tr>
                                </t>
                                <t t-foreach="data['companies']" t-as="block">
                                    <tr class="cst_company">
                                        <td colspan="5" t-out="block['company'].display_name"/>
                                        <td class="num" t-out="block['amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                    </tr>
                                    <t t-foreach="block['employees']" t-as="emp">
                                        <tr class="cst_sub">
                                            <td class="mid" t-out="emp_index + 1"/>
                                            <td colspan="4" t-out="emp['employee'].display_name"/>
                                            <td class="num" t-out="emp['amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                        </tr>
                                        <t t-foreach="emp['categories']" t-as="cat">
                                            <tr class="cst_group">
                                                <td class="mid" t-out="cat_index + 1"/>
                                                <td colspan="2" t-out="cat['category'].name or 'Kategoriyasiz'"/>
                                                <td class="num" t-out="cat['quantity']" t-options="{'widget': 'float', 'precision': 2}"/>
                                                <td/>
                                                <td class="num" t-out="cat['amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                            </tr>
                                            <t t-foreach="cat['products']" t-as="row">
                                                <tr>
                                                    <td class="mid" t-out="row_index + 1"/>
                                                    <td t-out="row['name']"/>
                                                    <td t-out="row['characteristic']"/>
                                                    <td class="num" t-out="row['quantity']" t-options="{'widget': 'float', 'precision': 2}"/>
                                                    <td class="num" t-out="row['rate']" t-options="{'widget': 'float', 'precision': 2}"/>
                                                    <td class="num" t-out="row['amount']" t-options="{'widget': 'float', 'precision': 2}"/>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
